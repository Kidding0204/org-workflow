;;; -*- lexical-binding: t; -*-
(require 'ert)
(require 'org-workflow-agenda-projects)
(load "org-workflow-agenda-workbench-test" nil t)

(ert-deftest workflow-project-view-tabs-share-workbench-not-date ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (let ((state org-workflow-agenda--workbench)
          (date (org-workflow-agenda-target-date)))
      (org-workflow-agenda-select-view 'projects)
      (should (eq state org-workflow-agenda--workbench))
      (should (equal date (org-workflow-agenda-target-date)))
      (should (equal 'projects (org-workflow-agenda--setting 'org-workflow-agenda-current-view)))
      (should (string-match-p "Inbox" (buffer-string)))
      (let ((right (org-workflow-agenda-workbench-candidates state)))
        (should (buffer-live-p right))
        (should (with-current-buffer right (string-match-p "Stage" (buffer-string)))))
      (org-workflow-agenda-select-view 'tomorrow)
      (should (eq state org-workflow-agenda--workbench))
      (should (equal "2026-08-18" (org-workflow-agenda-target-date))))))

(ert-deftest workflow-project-tree-includes-plain-headings-and-qa ()
  (org-workflow-workbench-test-with-files
      '("* DIVE Project\n** Plain\n*** TODO Step\n*** TODO Question :QA:\n**** TODO Refinement\n** Empty\n* HOLD Paused\n** Section\n*** TODO Later\n")
    (let* ((item (seq-find (lambda (p) (equal (plist-get p :title) "Project")) (org-workflow-projects-collect)))
           (progress (org-workflow-projects-progress item)))
      (should (= 1 (plist-get progress :total)))
      (should (equal '("Plain" "Empty") (mapcar (lambda (x) (plist-get x :title)) (plist-get progress :stages)))))
    (org-workflow-workbench-test-open)
    (org-workflow-agenda-select-view 'projects)
    (with-current-buffer (org-workflow-agenda-workbench-candidates org-workflow-agenda--workbench)
      (should (string-match-p "Plain" (buffer-string)))
      (should (string-match-p "Question.*QA" (buffer-string)))
      (should-not (string-match-p "Refinement" (buffer-string)))
      (should-not (string-match-p "0/0" (buffer-string)))
      (goto-char (point-min)) (search-forward "Paused")
      (org-workflow-agenda-project-toggle)
      (should (string-match-p "Later" (buffer-string))))))

(ert-deftest workflow-project-inbox-includes-old-and-scheduled-items ()
  (org-workflow-workbench-test-with-files
      '("* Inbox\n** TODO Old\n:PROPERTIES:\n:CAPTURED_ON: [2025-01-01 Wed 10:00]\n:END:\n** TODO Planned :QA:\nSCHEDULED: <2026-09-01 Tue>\n** Thought\n** DONE Finished\n* DIVE Project\n** Section\n*** TODO Step\n")
    (let ((org-workflow-projects-file (car files)))
    (org-workflow-workbench-test-open)
    (cl-letf (((symbol-function 'org-workflow-collection-inbox--review-files) (lambda () files)))
      (org-workflow-agenda-select-view 'projects))
    (should (string-match-p "Old" (buffer-string)))
    (should (string-match-p "Planned" (buffer-string)))
    (should-not (string-match-p "Thought\\|Finished" (buffer-string))))))
