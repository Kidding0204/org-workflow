;;; org-workflow-habit-reminders-test.el --- Work windows and habit reminders -*- lexical-binding: t; -*-
(require 'ert)
(require 'org-workflow-panel)
(require 'org-workflow-evening)
(load "org-workflow-habits-test" nil t)

(ert-deftest workflow-periods-gaps-and-exact-starts ()
  (let ((org-workflow-work-periods '((morning "08:30" "12:00")
                                   (afternoon "14:00" "17:30")
                                   (evening "19:00" "22:00"))))
    (dolist (case '((8 29 nil) (8 30 (65)) (12 0 (65)) (13 59 (65))
                    (14 0 (65 66)) (17 30 (65 66)) (18 59 (65 66))
                    (19 0 (65 66 67)) (22 0 (65 66 67))))
      (should (equal (nth 2 case)
                     (org-workflow-periods-priorities
                      (encode-time 0 (nth 1 case) (car case) 8 10 2026)))))
    (should (equal "17:30" (org-workflow-periods-clock 'afternoon 'late)))))

(ert-deftest workflow-periods-reject-invalid-windows ()
  (dolist (value '(((morning "08:30" "12:00") (afternoon "11:00" "17:30") (evening "19:00" "22:00"))
                    ((morning "08:30" "12:00") (afternoon "14:00" "17:30") (evening "22:00" "19:00"))
                    ((morning "08:60" "12:00") (afternoon "14:00" "17:30") (evening "19:00" "22:00"))
                    ((morning "08:30" "12:00"))))
    (should-error (org-workflow-periods--validate value) :type 'user-error)))

(ert-deftest workflow-habit-boundary-and-override ()
  (with-temp-buffer
    (org-mode) (insert "* TODO Habit\n:PROPERTIES:\n:STYLE: habit\n:WORKFLOW_HABIT_POSITION: afternoon-late\n:END:\n")
    (goto-char (point-min))
    (let ((org-workflow-work-periods '((morning "08:30" "12:00") (afternoon "14:00" "17:30") (evening "19:00" "22:00"))))
      (should (equal "17:30" (org-workflow-habits-reminder-clock)))
      (org-entry-put nil "WORKFLOW_HABIT_REMINDER" "18:10")
      (should (equal "18:10" (org-workflow-habits-reminder-clock))))
    (org-entry-put nil "WORKFLOW_HABIT_REMINDER" "25:00")
    (should-error (org-workflow-habits-reminder-clock) :type 'user-error)))

(ert-deftest workflow-habit-positioned-agenda-keeps-tracking-and-task-order ()
  (workflow-habit-test
   (with-temp-file org-workflow-habit-file
     (insert "#+TODO: TODO | DONE\n* TODO Early habit\nSCHEDULED: <2026-10-08 Thu .+1d>\n:PROPERTIES:\n:STYLE: habit\n:WORKFLOW_HABIT_POSITION: afternoon-early\n:END:\n* TODO Late habit\nSCHEDULED: <2026-10-08 Thu .+1d>\n:PROPERTIES:\n:STYLE: habit\n:WORKFLOW_HABIT_POSITION: afternoon-late\n:END:\n"))
   (cl-letf (((symbol-function 'org-workflow-agenda-target-date) (lambda () "2026-10-08"))
             ((symbol-function 'org-workflow-agenda--insert-day-tabs) #'ignore)
             ((symbol-function 'org-workflow-agenda--completed-periods) (lambda (_) nil))
             ((symbol-function 'org-workflow-target--valid-entry-p) (lambda (_) t))
             ((symbol-function 'org-workflow-target--ordered-entries)
              (lambda (&rest _) (list (org-workflow-target-entry-create :title "First task" :priority (org-get-priority "[#B]"))
                                     (org-workflow-target-entry-create :title "Second task" :priority (org-get-priority "[#B]")))))
             ((symbol-function 'org-workflow-target--group-key) (lambda (_) "group"))
             ((symbol-function 'org-workflow-agenda--entry-group-title) (lambda (_) "Tasks"))
             ((symbol-function 'org-workflow-agenda--period-load) (lambda (_) ""))
             ((symbol-function 'org-workflow-agenda--stack-line) (lambda (entry _) (org-workflow-target-entry-title entry))))
     (let ((rows (org-workflow-evening--habit-rows "2026-10-08")))
       (with-temp-buffer
         (org-workflow-agenda-task-stack nil rows)
         (should-not (string-match-p "习惯 ·" (buffer-string)))
         (should (string-match-p "连续 0 天\n    Tasks" (buffer-string)))
         (should (string-match-p "Second task\n    ↻ Late habit" (buffer-string)))
         (goto-char (point-min))
         (search-forward "Early habit")
         (should (eq 'habit (get-text-property (1- (point)) 'org-workflow-agenda-create-context)))
         (should (markerp (get-text-property (1- (point)) 'org-hd-marker)))
         (search-forward "连续")
         (search-forward "First task") (search-forward "Second task")
         (search-forward "Late habit") (search-forward "连续"))))))

(ert-deftest workflow-habit-reminders-latest-skip-restart-and-day-rollover ()
  (workflow-habit-test
   (let ((rows [(:key "old" :title "Old" :done :false :reminderTime "12:00")
                (:key "new" :title "New" :done :false :reminderTime "17:30")])
         notifications
         (date "2026-10-08"))
     (cl-letf (((symbol-function 'org-workflow-panel--habits) (lambda (_) rows))
               ((symbol-function 'org-workflow-habits-items)
                (lambda (day)
                  (mapcar (lambda (row)
                            (org-workflow-target-entry-create
                             :kind 'habit :id (plist-get row :key) :title (plist-get row :title)
                             :marker (make-marker) :occurrence-date day
                             :done (eq t (plist-get row :done))
                             :reminder-time (plist-get row :reminderTime))) rows)))
               ((symbol-function 'org-workflow-target--today-string) (lambda () date))
               ((symbol-function 'org-workflow--request-gnome-refresh) #'ignore)
               ((symbol-function 'org-workflow--notify) (lambda (_title body) (push body notifications))))
       (org-workflow-panel--reminder-tick (encode-time 0 59 11 8 10 2026))
       (should-not notifications)
       (org-workflow-panel--reminder-tick (encode-time 0 0 12 8 10 2026))
       (should (equal "old" (plist-get (org-workflow-panel-current-habit) :key)))
       (org-workflow-panel--reminder-tick (encode-time 0 30 17 8 10 2026))
       (should (equal "new" (plist-get (org-workflow-panel-current-habit) :key)))
       (should (equal '("New" "Old") notifications))
       ;; Reopening storage models a restart: delivered reminders never repeat.
       (sqlite-close org-workflow-store--connection)
       (setq org-workflow-store--connection nil)
       (org-workflow-panel--reminder-tick (encode-time 0 0 18 8 10 2026))
       (should (= 2 (length notifications)))
       (org-workflow-panel-skip-habit)
       (should-not (org-workflow-panel-current-habit))
       (org-workflow-panel--reminder-tick (encode-time 0 0 20 8 10 2026))
       (should-not (org-workflow-panel-current-habit))
       (should (= 2 (length notifications)))
       (setq date "2026-10-09")
       (org-workflow-panel--reminder-tick (encode-time 0 0 12 9 10 2026))
       (should (equal "old" (plist-get (org-workflow-panel-current-habit) :key)))
       (should (= 3 (length notifications)))))))

(ert-deftest workflow-habit-completed-and-unconfigured-never-notify ()
  (workflow-habit-test
   (cl-letf (((symbol-function 'org-workflow-panel--habits)
              (lambda (_) [(:key "done" :title "Done" :done t :reminderTime "08:30")
                           (:key "plain" :title "Plain" :done :false :reminderTime nil)]))
             ((symbol-function 'org-workflow--notify) (lambda (&rest _) (ert-fail "Unexpected notification"))))
     (org-workflow-panel--reminder-tick (encode-time 0 0 22 8 10 2026))
     (should-not (org-workflow-panel--reminder-state "2026-10-08")))))

(ert-deftest workflow-habit-completion-clears-current-without-resurfacing ()
  (workflow-habit-test
   (let ((rows [(:key "old" :done :false) (:key "new" :done t)]))
     (cl-letf (((symbol-function 'org-workflow-panel--habits) (lambda (_) rows))
               ((symbol-function 'org-workflow-target--today-string) (lambda () "2026-10-08"))
               ((symbol-function 'org-workflow--request-gnome-refresh) #'ignore))
       (org-workflow-panel--save-reminder-state "2026-10-08" '(:sent ["old" "new"] :skipped [] :current "new"))
       (should-not (org-workflow-panel-current-habit))
       (org-workflow-panel--reminder-tick (encode-time 0 0 20 8 10 2026))
       (should-not (plist-get (org-workflow-panel--reminder-state "2026-10-08") :current))))))

(ert-deftest workflow-habit-reminder-key-survives-outline-edits ()
  (workflow-habit-test
   (with-temp-file org-workflow-habit-file
     (insert "* TODO Run\nSCHEDULED: <2026-10-08 Thu .+1d>\n:PROPERTIES:\n:ID: stable\n:STYLE: habit\n:WORKFLOW_HABIT_POSITION: afternoon-late\n:END:\n"))
   (should (equal "stable" (plist-get (aref (org-workflow-panel--habits "2026-10-08") 0) :key)))
   (with-current-buffer (find-file-noselect org-workflow-habit-file)
     (goto-char (point-min)) (insert "New preamble\n\n"))
   (should (equal "stable" (plist-get (aref (org-workflow-panel--habits "2026-10-08") 0) :key)))))

(provide 'org-workflow-habit-reminders-test)

(ert-deftest workflow-habit-desktop-dispatch-uses-shared-commands ()
  (let ((org-workflow-external-actions '((start . org-workflow-target-start)
                                        (toggle . org-workflow-focus-toggle)
                                        (complete . org-workflow-target-complete))) calls)
    (cl-letf (((symbol-function 'org-workflow-target-start)
               (lambda () (interactive) (push 'start calls)))
              ((symbol-function 'org-workflow-focus-toggle)
               (lambda () (interactive) (push 'toggle calls)))
              ((symbol-function 'org-workflow-target-complete)
               (lambda () (interactive) (push 'complete calls)))
              ((symbol-function 'org-workflow-panel-habit-action)
               (lambda (_) (ert-fail "Desktop dispatch must not branch through presentation"))))
      (dolist (action '(start toggle complete)) (should (plist-get (org-workflow-dispatch action) :ok)))
      (should (equal '(complete toggle start) calls)))))

(ert-deftest workflow-habit-reminder-timer-is-owned-by-workflow-mode ()
  (let ((org-workflow-panel--reminder-timer (run-at-time 3600 nil #'ignore)))
    (org-workflow--cancel-background-work)
    (should-not org-workflow-panel--reminder-timer)))

(ert-deftest workflow-habit-configure-saves-position-without-changing-repeat ()
  (workflow-habit-test
   (org-workflow-habits-create "Read")
   (let ((schedule (org-entry-get nil "SCHEDULED")))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "下午·初"))
               ((symbol-function 'read-string) (lambda (&rest _) "14:15")))
       (org-workflow-habits-configure))
     (should (equal "afternoon-early" (org-entry-get nil "WORKFLOW_HABIT_POSITION")))
     (should (equal "14:15" (org-workflow-habits-reminder-clock)))
     (should (equal schedule (org-entry-get nil "SCHEDULED")))
     (let ((before (buffer-string)))
       (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "晚上·末"))
                 ((symbol-function 'read-string) (lambda (&rest _) "24:99")))
         (should-error (org-workflow-habits-configure) :type 'user-error))
       (should (equal before (buffer-string)))))))

(ert-deftest workflow-habit-real-source-reminder-skip-preserves-completion-facts ()
  (workflow-habit-test
   (org-workflow-habits-create "Run")
   (org-entry-put nil "WORKFLOW_HABIT_POSITION" "afternoon-late")
   (let ((before (buffer-string))
         (date (org-workflow-target--today-string)))
     (cl-letf (((symbol-function 'org-workflow--request-gnome-refresh) #'ignore)
               ((symbol-function 'org-workflow--notify) #'ignore))
       (org-workflow-panel--reminder-tick (org-time-string-to-time (concat date " 22:00")))
       (should (equal "Run" (plist-get (org-workflow-panel-current-habit) :title)))
       (org-workflow-panel-skip-habit)
       (should (equal before (buffer-string)))
       (should-not (org-workflow-habits-records date))
       (should-not (org-workflow-panel-current-habit))))))
