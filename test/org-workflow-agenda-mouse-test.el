(ert-deftest my/org-mouse-drag-release-arranges-and-cancel-cleans-highlight ()
  (dolist (cancel '(nil 27 7 release-only))
    (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
      (let ((org-workflow-store-enabled nil))
        (my/org-mouse-test-open)
        (pcase-let ((`(,primary ,candidate) (org-workflow-workbench-test-panes)))
          (let* ((target-window (get-buffer-window primary))
                 (position (my/org-mouse-test-target-position target-window "2026-08-17" ?C)))
            (select-window (get-buffer-window candidate))
            (let* ((marker (copy-marker (my/org-mouse-test-row "First")))
                   (source (with-current-buffer (marker-buffer marker) (buffer-string)))
                   (events (if (eq cancel 'release-only)
                               (list (list 'drag-mouse-1
                                           (event-start (my/org-mouse-test-event 'down-mouse-1))
                                           position))
                             (list (list 'mouse-movement position)
                                   (or cancel (list 'mouse-1 position))))))
              (cl-letf (((symbol-function 'read-event)
                         (lambda (&rest _) (or (pop events) (ert-fail "Unexpected event read"))))
                        ((symbol-function 'org-workflow-agenda-mouse--scroll-target) #'ignore))
                (org-workflow-agenda-mouse-down (my/org-mouse-test-event 'down-mouse-1)))
              (if (memq cancel '(27 7))
                  (should (equal source (with-current-buffer (marker-buffer marker) (buffer-string))))
                (org-with-point-at marker
                  (should (equal "2026-08-17"
                                 (org-workflow-target--timestamp-date (org-entry-get nil "SCHEDULED"))))
                  (should (= ?C (nth 3 (org-heading-components))))))
              (with-current-buffer primary
                (should-not (seq-some (lambda (overlay)
                                       (and (eq (overlay-get overlay 'face) 'highlight)
                                            (overlay-get overlay 'window)))
                                     (overlays-in (point-min) (point-max))))))))))))

(ert-deftest my/org-mouse-auto-scroll-only-originating-workbench ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (let ((window (selected-window))
          (state org-workflow-agenda--workbench)
          scrolls)
      (cl-letf (((symbol-function 'scroll-down)
                 (lambda (amount) (push (list 'down amount) scrolls)))
                ((symbol-function 'scroll-up)
                 (lambda (amount) (push (list 'up amount) scrolls)))
                ((symbol-function 'window-body-height) (lambda (&rest _) 400)))
        (org-workflow-agenda-mouse--scroll-target (list window (point) '(20 . 0) 0) state)
        (org-workflow-agenda-mouse--scroll-target
         (list window (point) (cons 20 (window-body-height window t)) 0) state)
        (should (equal '((up 1) (down 1)) scrolls))
        (org-workflow-agenda-mouse--scroll-target
         (list window (point) '(20 . 0) 0) (org-workflow-agenda-workbench-create))
        (let ((org-workflow-agenda--pane-role 'candidates))
          (org-workflow-agenda-mouse--scroll-target
           (list window (point) '(20 . 0) 0) state))
        (should (= 2 (length scrolls)))))))

(ert-deftest my/org-mouse-mixed-drop-skips-already-correct-task ()
  (org-workflow-workbench-test-with-files
      '("#+filetags: :project:\n* Project :CURR:\n** TODO [#B] Already\nSCHEDULED: <2026-08-17 Mon>\n** TODO [#A] New\nSCHEDULED: <2026-08-17 Mon>\n")
    (let ((org-workflow-store-enabled nil))
      (org-workflow-workbench-test-open)
      (let ((already (copy-marker (my/org-mouse-test-row "Already")))
            (new (copy-marker (my/org-mouse-test-row "New")))
            (original (symbol-function 'org-agenda-schedule))
            scheduled)
        (cl-letf (((symbol-function 'org-agenda-schedule)
                   (lambda (&rest args)
                     (push (copy-marker (org-get-at-bol 'org-hd-marker)) scheduled)
                     (apply original args))))
          (org-workflow-agenda-mouse--drop (list already new) "2026-08-17" ?B))
        (should (= 1 (length scheduled)))
        (should (equal new (car scheduled)))))))

