;;; org-workflow-agenda-mouse-test.el --- Sprint mouse regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'org-workflow-agenda-workbench-test
         (expand-file-name "org-workflow-agenda-workbench-test.el"
                           (file-name-directory (or load-file-name buffer-file-name))))
(require 'org-workflow-agenda-mouse)

(defun my/org-mouse-test-open ()
  "Open the candidate pane for mouse tests of unscheduled project tasks."
  (org-workflow-workbench-test-open)
  (pcase-let ((`(,_primary ,candidate) (org-workflow-workbench-test-panes)))
    (select-window (get-buffer-window candidate))))

(defun my/org-mouse-test-row (title)
  "Move to the task named TITLE and return its native source marker."
  (goto-char (point-min))
  (let (found)
    (while (and (not found) (< (point) (point-max)))
      (when-let* ((marker (org-get-at-bol 'org-hd-marker)))
        (when (equal title (org-with-point-at marker (org-get-heading t t t t)))
          (setq found marker)))
      (unless found (forward-line)))
    (should found)
    found))

(defun my/org-mouse-test-selected ()
  "Return sorted source titles selected through native Agenda bulk marks."
  (sort (mapcar (lambda (marker)
                 (org-with-point-at marker (org-get-heading t t t t)))
               org-agenda-bulk-marked-entries)
        #'string-lessp))

(defun my/org-mouse-test-event (type)
  "Build a buffer-position event for the selected test window."
  (list type (list (selected-window) (point) '(10 . 10) 0)))

(ert-deftest my/org-mouse-right-press-overrides-global-context-menu ()
  (let ((was-enabled context-menu-mode))
    (unwind-protect
        (progn
          (context-menu-mode 1)
          (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
            (my/org-mouse-test-open)
            (my/org-mouse-test-row "First")
            (dolist (evil-enabled '(nil t))
              (if evil-enabled (evil-local-mode 1) (evil-local-mode -1))
              (when evil-enabled (evil-normal-state))
              (org-workflow-agenda-mouse--setup)
              (should (eq (key-binding [down-mouse-3]) #'org-workflow-agenda-mouse-menu))
              (should (eq (key-binding [mouse-3]) #'ignore))
              (let (menu)
                (cl-letf (((symbol-function 'popup-menu)
                           (lambda (value &rest _) (setq menu value))))
                  (funcall (key-binding [down-mouse-3])
                           (my/org-mouse-test-event 'down-mouse-3)))
                (should (assq 'morning (cdr menu)))
                (should (equal '("First") (my/org-mouse-test-selected))))))
          (with-temp-buffer
            (org-agenda-mode)
            (org-workflow-agenda-mouse--setup)
            (should-not org-workflow-agenda-mouse-mode)
            (should-not (eq (key-binding [down-mouse-3]) #'org-workflow-agenda-mouse-menu))
            (should (keymapp (key-binding [down-mouse-3])))))
      (context-menu-mode (if was-enabled 1 -1)))))

