(ert-deftest my/org-mouse-batch-commitment-updates-all-and-rolls-back-bad-date ()
  (dolist (bad-date '(nil t))
    (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
      (let* ((directory (make-temp-file "mouse-commitment-" t))
             (org-workflow-store-file (expand-file-name "facts.sqlite" directory))
             (org-workflow-store--connection nil)
             (org-workflow-store--path nil)
             (org-workflow-store-enabled t)
             (org-id-locations-file (expand-file-name "ids" directory))
             (org-id-locations (make-hash-table :test #'equal))
             (org-id-files nil)
             (org-workflow-agenda-last-plan nil)
             (org-workflow-executing-marker nil)
             (org-workflow-target-selected-marker nil)
             (org-workflow-current-changed-hook nil))
        (unwind-protect
            (progn
              (org-workflow-workbench-test-open)
              ;; Exercise the legacy renderer API; Sprint itself hides this section.
              (org-workflow-agenda-future nil)
              (let* ((first (copy-marker (my/org-mouse-test-row (if bad-date "Today" "Tomorrow"))))
                     (second (copy-marker (my/org-mouse-test-row "Later")))
                     (source-buffer (marker-buffer first))
                     (source (with-current-buffer source-buffer (buffer-string))))
                ;; Native bulk marks prepend; Later is processed before the bad Today date.
                (org-workflow-agenda-mouse--select first nil)
                (org-workflow-agenda-mouse--select second 'control)
                (if bad-date
                    (progn
                      (should-error (org-workflow-agenda-mouse-toggle-commitment) :type 'user-error)
                      (should (equal source (with-current-buffer source-buffer (buffer-string))))
                      (should (= 0 (caar (sqlite-select
                                          (org-workflow-store--db)
                                          "SELECT count(*) FROM commitments")))))
                  (org-workflow-agenda-mouse-toggle-commitment)
                  (dolist (marker (list first second))
                    (org-with-point-at marker
                      (should (org-workflow-store-commitment
                               (org-entry-get nil "WORKFLOW_COMMITMENT_ID")))))
                  (should org-workflow-agenda-last-plan)
                  (should-not org-agenda-bulk-marked-entries))))
          (when (and org-workflow-store--connection
                     (org-workflow-store--live-p org-workflow-store--connection))
            (sqlite-close org-workflow-store--connection))
          (delete-directory directory t))))))

