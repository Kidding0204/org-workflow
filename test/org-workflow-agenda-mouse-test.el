(ert-deftest my/org-mouse-dedicated-open-restores-origin-tab-and-keeps-panes ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let ((saved-tabs (frame-parameter nil 'tabs)))
      (unwind-protect
          (progn
            (switch-to-buffer (get-buffer-create "*Mouse original editor*"))
            (let ((origin-index (tab-bar--current-tab-index)))
              (org-workflow-agenda-open-workbench)
              (let* ((state org-workflow-agenda--workbench)
                     (candidate (org-workflow-agenda-workbench-candidates state))
                     (primary (org-workflow-agenda-workbench-primary state))
                     (count (length (tab-bar-tabs))))
                (select-window (get-buffer-window candidate))
                (let ((marker (my/org-mouse-test-row "First")))
                  (org-workflow-agenda-mouse-open)
                  (should (= origin-index (tab-bar--current-tab-index)))
                  (should (= count (length (tab-bar-tabs))))
                  (should (eq (current-buffer) (marker-buffer marker)))
                  (should (= (point) (marker-position marker))))
                (let ((index (seq-position (tab-bar-tabs) state
                                          (lambda (tab workbench)
                                            (eq (alist-get 'org-workflow-agenda-workbench tab)
                                                workbench)))))
                  (should index)
                  (tab-bar-select-tab (1+ index))
                  (should (get-buffer-window primary))
                  (should (get-buffer-window candidate))
                  (tab-bar-close-tab)))))
        (set-frame-parameter nil 'tabs saved-tabs)))))

(ert-deftest my/org-mouse-dedicated-open-creates-tab-if-origin-closed ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let ((saved-tabs (frame-parameter nil 'tabs)))
      (unwind-protect
          (progn
            (org-workflow-agenda-open-workbench)
            (let* ((state org-workflow-agenda--workbench)
                   (token (gethash 'mouse-origin-tab
                                   (org-workflow-agenda-workbench-settings state)))
                   (origin (seq-position (tab-bar-tabs) token
                                         (lambda (tab id)
                                           (eq (alist-get 'org-workflow-agenda-origin tab) id)))))
              (should origin)
              (tab-bar-close-tab (1+ origin))
              (select-window (get-buffer-window (org-workflow-agenda-workbench-candidates state)))
              (let ((marker (my/org-mouse-test-row "First"))
                    (count (length (tab-bar-tabs))))
                (org-workflow-agenda-mouse-open)
                (should (= (1+ count) (length (tab-bar-tabs))))
                (should (eq (current-buffer) (marker-buffer marker)))
                (should (= (point) (marker-position marker)))
                (should (buffer-live-p (org-workflow-agenda-workbench-primary state)))
                (should (buffer-live-p (org-workflow-agenda-workbench-candidates state)))
                (tab-bar-close-tab))))
        (set-frame-parameter nil 'tabs saved-tabs)))))

(ert-deftest my/org-mouse-drop-plans-explicit-day-and-refreshes-both-panes ()
  (dolist (date '("2026-08-17" "2026-08-18" "2026-08-23"))
    (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
      (let ((org-workflow-store-enabled nil))
        (my/org-mouse-test-open)
        (pcase-let ((`(,primary ,candidate) (org-workflow-workbench-test-panes)))
          (with-current-buffer candidate
            (let ((first (copy-marker (my/org-mouse-test-row "First")))
                  (second (copy-marker (my/org-mouse-test-row "Second"))))
              (org-workflow-agenda-mouse--drop (list first second) date ?B)
              (dolist (marker (list first second))
                (org-with-point-at marker
                  (should (= ?B (nth 3 (org-heading-components))))
                  (should (equal date (org-workflow-target--timestamp-date
                                      (org-entry-get nil "SCHEDULED"))))))
              (should-not org-agenda-bulk-marked-entries)
              (should-not org-workflow-agenda-mouse--anchor)
              (should (equal "2026-08-17" (org-workflow-agenda-target-date)))
              (should-not (member "First" (org-workflow-workbench-test-titles candidate)))
              (should-not (member "Second" (org-workflow-workbench-test-titles candidate)))
              (if (equal date "2026-08-17")
                  (progn
                    (should (member "First" (org-workflow-workbench-test-titles primary)))
                    (should (member "Second" (org-workflow-workbench-test-titles primary))))
                (should-not (member "First" (org-workflow-workbench-test-titles primary)))
                (should-not (member "Second" (org-workflow-workbench-test-titles primary)))))))))))

(ert-deftest my/org-mouse-drop-no-op-keeps-source-and-undo-record ()
  (org-workflow-workbench-test-with-files
      '("#+filetags: :project:\n* Project :CURR:\n** TODO [#B] Already\nSCHEDULED: <2026-08-17 Mon>\n")
    (let ((org-workflow-store-enabled nil)
          (org-workflow-agenda-last-plan '(previous-plan)))
      (org-workflow-workbench-test-open)
      (let ((marker (my/org-mouse-test-row "Already"))
            (source (with-current-buffer (find-file-noselect (car files)) (buffer-string))))
