(ert-deftest my/org-mouse-drop-rejects-invalid-readonly-and-hidden-batch ()
  (dolist (invalid-kind '(invalid readonly hidden))
    (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
      (let ((org-workflow-store-enabled nil))
        (my/org-mouse-test-open)
        (let* ((first (copy-marker (my/org-mouse-test-row "First")))
               (second (copy-marker (my/org-mouse-test-row "Second")))
               (source-buffer (marker-buffer first))
               (source (with-current-buffer source-buffer (buffer-string))))
          (unwind-protect
              (progn
                (pcase invalid-kind
                  ('invalid (set-marker second nil))
                  ('readonly (with-current-buffer source-buffer (setq buffer-read-only t)))
                  ('hidden (org-workflow-agenda--filter-tag "@deep")))
                (should-error (org-workflow-agenda-mouse--drop (list first second) "2026-08-18" ?A)
                              :type 'user-error)
                (should (equal source (with-current-buffer source-buffer (buffer-string)))))
            (with-current-buffer source-buffer (setq buffer-read-only nil))))))))

(ert-deftest my/org-mouse-drop-rolls-back-on-mid-batch-failure ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let ((org-workflow-store-enabled nil))
      (my/org-mouse-test-open)
      (let* ((first (copy-marker (my/org-mouse-test-row "First")))
             (second (copy-marker (my/org-mouse-test-row "Second")))
             (source-buffer (marker-buffer first))
             (source (with-current-buffer source-buffer (buffer-string)))
             (original (symbol-function 'org-agenda-schedule))
             (calls 0))
        (cl-letf (((symbol-function 'org-agenda-schedule)
                   (lambda (&rest args)
                     (if (= (cl-incf calls) 2)
                         (error "Injected second-task failure")
                       (apply original args)))))
          (should-error (org-workflow-agenda-mouse--drop (list first second) "2026-08-18" ?A)))
        (should (= calls 2))
        (should (equal source (with-current-buffer source-buffer (buffer-string))))))))

(ert-deftest my/org-mouse-drop-batch-undo-restores-source-and-two-panes ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let* ((directory (make-temp-file "mouse-undo-" t))
           (org-workflow-store-file (expand-file-name "facts.sqlite" directory))
           (org-workflow-store--connection nil)
           (org-workflow-store--path nil)
           (org-workflow-store-enabled t)
           (org-id-locations-file (expand-file-name "ids" directory))
           (org-id-locations (make-hash-table :test #'equal))
           (org-id-files nil)
           (org-workflow-agenda-last-plan nil)
           (org-workflow-executing-marker nil)
           (org-workflow-target-selected-marker nil)
           (org-workflow-current-changed-hook nil))
      (unwind-protect
          (progn
            (my/org-mouse-test-open)
            (pcase-let ((`(,primary ,candidate) (org-workflow-workbench-test-panes)))
              (with-current-buffer candidate
                (let ((markers (list (copy-marker (my/org-mouse-test-row "First"))
                                     (copy-marker (my/org-mouse-test-row "Second")))))
                  (org-workflow-agenda-mouse--drop markers "2026-08-18" ?C)
                  (should org-workflow-agenda-last-plan)
                  (should (= 2 (length (plist-get org-workflow-agenda-last-plan :markers))))
                  (org-workflow-agenda-undo-plan)
                  (dolist (marker markers)
                    (org-with-point-at marker
                      (should-not (org-entry-get nil "SCHEDULED"))
                      (should-not (nth 3 (org-heading-components)))))))
              (should-not org-workflow-agenda-last-plan)
              (should (member "First" (org-workflow-workbench-test-titles candidate)))
              (should (member "Second" (org-workflow-workbench-test-titles candidate)))
              (should-not (member "First" (org-workflow-workbench-test-titles primary)))
              (should-not (member "Second" (org-workflow-workbench-test-titles primary)))))
        (when (and org-workflow-store--connection
                   (org-workflow-store--live-p org-workflow-store--connection))
          (sqlite-close org-workflow-store--connection))
        (delete-directory directory t)))))

(defun my/org-mouse-test-target-position (window date period)
  "Return a native position inside WINDOW's DATE and PERIOD band."
  (with-current-buffer (window-buffer window)
    (let ((position (point-min)) found)
      (while (and (< position (point-max)) (not found))
        (if (equal (list 'task date period)
                   (get-text-property position 'org-workflow-agenda-create-context))
            (setq found position)
          (setq position (next-single-property-change
                          position 'org-workflow-agenda-create-context nil (point-max)))))
      (should found)
      (list window found '(30 . 30) 0))))

(ert-deftest my/org-mouse-drop-target-rejects-candidates-and-other-workbench ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (my/org-mouse-test-open)
