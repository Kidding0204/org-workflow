;;; -*- lexical-binding: t; -*-
(require 'ert)
(require 'org-workflow-periods)
(ert-deftest workflow-period-clock-progress-boundaries ()
  (let ((org-workflow-work-periods '((morning "08:30" "12:00")
                                    (afternoon "14:00" "17:30")
                                    (evening "19:00" "21:30"))))
    (cl-flet ((at (h m) (encode-time 0 m h 28 10 2026)))
      (should-not (org-workflow-periods-current-window (at 8 29)))
      (dolist (case '((8 30 "morning" 8 30 12 0)
                      (12 53 "morning" 8 30 12 0)
                      (14 0 "afternoon" 14 0 17 30)
                      (19 0 "evening" 19 0 21 30)
                      (23 59 "evening" 19 0 21 30)))
        (pcase-let ((`(,h ,m ,name ,sh ,sm ,eh ,em) case))
          (let ((window (org-workflow-periods-current-window (at h m))))
            (should (equal name (plist-get window :name)))
            (should (= (float-time (at sh sm)) (plist-get window :start)))
            (should (= (float-time (at eh em)) (plist-get window :end)))))))))
