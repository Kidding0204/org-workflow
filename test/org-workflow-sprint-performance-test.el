(ert-deftest workflow-sprint-source-cache-rechecks-database-pause ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let (paused)
      (cl-letf (((symbol-function 'org-workflow-projects--goal-pause) (lambda (_) paused)))
        (org-workflow-workbench-test-open)
        (should (member "First" (org-workflow-workbench-test-titles)))
        (setq paused "pause-batch")
        (org-agenda-redo)
        (should-not (member "First" (org-workflow-workbench-test-titles)))
        (setq paused nil)
        (org-agenda-redo)
        (should (member "First" (org-workflow-workbench-test-titles)))))))

(ert-deftest workflow-sprint-progress-reuses-private-values-and-fresh-markers ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let ((reads 0) (original (symbol-function 'org-workflow-projects--progress-at-point)))
      (cl-letf (((symbol-function 'org-workflow-projects--progress-at-point)
                 (lambda () (cl-incf reads) (funcall original))))
        (org-workflow-workbench-test-open)
        (let* ((marker (save-excursion
                         (goto-char (point-min)) (search-forward "First")
                         (org-get-at-bol 'org-hd-marker)))
               (buffer (marker-buffer marker)) (position (marker-position marker)))
          (org-agenda-redo)
          (should (= 1 reads))
          (goto-char (point-min)) (search-forward "First")
          (let ((next (org-get-at-bol 'org-hd-marker)))
            (should (eq buffer (marker-buffer next)))
            (should (= position (marker-position next)))
            (should-not (eq marker next))))
        (let* ((org-workflow-source--reuse-reads t)
               (project (cadr (org-workflow-projects-collect)))
               (progress (org-workflow-projects-progress project)))
          (setf (plist-get progress :total) -1)
          (setf (plist-get (car (plist-get progress :stages)) :total) -1)
          (let ((next (org-workflow-projects-progress project)))
            (should (> (plist-get next :total) 0))
            (should (> (plist-get (car (plist-get next :stages)) :total) 0))))))))

(ert-deftest workflow-sprint-source-cache-sees-indirect-unsaved-edits ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let ((agenda (org-workflow-workbench-test-open))
          (source (find-file-noselect (car files))))
      (with-current-buffer source
        (let ((indirect (clone-indirect-buffer " *sprint-edit*" nil)))
          (with-current-buffer indirect
            (goto-char (point-min)) (search-forward "TODO First")
            (replace-match "DONE First"))))
      (with-current-buffer agenda
        (org-agenda-redo)
        (should-not (member "First" (org-workflow-workbench-test-titles)))
        (should (string-match-p "\\[1/" (buffer-string)))))))

(ert-deftest workflow-sprint-source-cache-drops-killed-source-and-reads-disk ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let ((agenda (org-workflow-workbench-test-open)))
      (kill-buffer (find-file-noselect (car files)))
      (with-temp-file (car files)
        (insert (replace-regexp-in-string "First" "Reopened" org-workflow-workbench-test-source)))
      (with-current-buffer agenda
        (org-agenda-redo)
        (should (member "Reopened" (org-workflow-workbench-test-titles)))
        (should-not (member "First" (org-workflow-workbench-test-titles)))))))

(ert-deftest workflow-sprint-source-cache-next-step-changes-at-midnight ()
  (org-workflow-workbench-test-with-files
      '("* DIVE Project\n** DIVE Stage\n*** TODO Future\nSCHEDULED: <2026-08-18 Tue>\n*** TODO Backup\n")
    (find-file-noselect (car files))
    (let ((org-workflow-source--reuse-reads t))
      (should (equal "Backup" (plist-get (plist-get (cadr (org-workflow-projects-collect)) :next) :title)))
      (cl-letf (((symbol-function 'org-workflow-target--today-string) (lambda () "2026-08-18")))
        (should (equal "Future" (plist-get (plist-get (cadr (org-workflow-projects-collect)) :next) :title)))))))

(ert-deftest workflow-sprint-disable-releases-source-facts ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (with-current-buffer (find-file-noselect (car files))
      (should org-workflow-source--read-cache)
      (org-workflow--cancel-background-work)
      (should-not org-workflow-source--read-cache))))

(provide 'org-workflow-sprint-performance-test)

(ert-deftest workflow-sprint-next-step-stops-after-first-active-candidate ()
  (org-workflow-workbench-test-with-files
      '("* DIVE Project\n** TODO Backlog\n*** TODO Backup\n** DIVE Active\n*** TODO Chosen\n*** TODO Unneeded\n")
    (let ((tail-reads 0) (original (symbol-function 'org-workflow-projects--location)))
      (cl-letf (((symbol-function 'org-workflow-projects--location)
                 (lambda ()
                   (when (equal "Unneeded" (org-get-heading t t t t)) (cl-incf tail-reads))
                   (funcall original))))
        (let ((next (plist-get (cadr (org-workflow-projects-collect)) :next)))
          (should (equal "Chosen" (plist-get next :title)))
          (should (equal "Active" (plist-get next :phase)))
          (should (plist-get next :active))
          (should (= 0 tail-reads)))))))

(ert-deftest workflow-sprint-next-step-retains-first-fallback-without-active-work ()
  (org-workflow-workbench-test-with-files
      '("* DIVE Project\n** TODO Backlog\n*** TODO Backup\n*** TODO Later\n** DIVE Future\n*** TODO Tomorrow\nSCHEDULED: <2026-08-18 Tue>\n** HOLD Paused\n*** TODO Hidden\n")
    (let ((next (plist-get (cadr (org-workflow-projects-collect)) :next)))
      (should (equal "Backup" (plist-get next :title)))
      (should (equal "Backlog" (plist-get next :phase)))
      (should-not (plist-get next :active)))))

(ert-deftest workflow-sprint-anytime-stops-scanning-after-four-results ()
  (org-workflow-workbench-test-with-files
      '("* DIVE Project\n** DIVE Stage\n*** TODO One\n*** TODO Two\n*** TODO Three\n*** TODO Four\n*** TODO Five\n*** TODO Six\n")
    (let ((visits 0) (original (symbol-function 'org-map-entries)))
      (cl-letf (((symbol-function 'org-map-entries)
                 (lambda (reader &optional match scope &rest skip)
                   (apply original (if (eq scope 'tree)
                                       (lambda () (cl-incf visits) (funcall reader)) reader)
                          match scope skip))))
        (let ((entries (cdar (org-workflow-agenda-anytime-projects))))
          (should (equal '("One" "Two" "Three" "Four")
                         (mapcar #'org-workflow-target-entry-title entries)))
          (should (= 6 visits)))))))

(ert-deftest workflow-sprint-completed-period-skips-sources-without-todays-closed ()
  (org-workflow-workbench-test-with-files
      '("* DIVE Project\n** DIVE Stage\n*** DONE Yesterday\nCLOSED: [2026-08-16 Sun 18:00]\nSCHEDULED: <2026-08-16 Sun>\n*** TODO Pending\n")
    (let ((scans 0) (original (symbol-function 'org-map-entries)))
      (cl-letf (((symbol-function 'org-map-entries)
                 (lambda (&rest args) (cl-incf scans) (apply original args))))
        (should-not (org-workflow-agenda--completed-arranged "2026-08-17"))
        (should (= 0 scans))))))
