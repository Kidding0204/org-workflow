(ert-deftest workflow-history-panel-refresh-stale-retains-loading-one-read-recovery ()
  (let ((payload (workflow-history-view-test--payload (workflow-history-view-test--day "2026-09-16"))))
    (workflow-history-view-test--panel payload
      (let ((before org-workflow-history-panel--model) (reads 0))
        (cl-letf (((symbol-function 'org-workflow-history-read)
                   (lambda (&rest _)
                     (cl-incf reads)
                     (should (eq 'loading (plist-get org-workflow-history-panel--model :state)))
                     (should (eq (plist-get before :payload) (plist-get org-workflow-history-panel--model :payload)))
                     (should (string-match-p "正在刷新历史…" (buffer-string)))
                     (org-workflow-history-panel-refresh)
                     (error "出错"))))
          (org-workflow-history-panel-refresh))
        (should (= 1 reads))
        (should (eq 'stale (plist-get org-workflow-history-panel--model :state)))
        (dolist (key '(:payload :summary :detail :selected-date :last-success))
          (should (eq (plist-get before key) (plist-get org-workflow-history-panel--model key))))
        (should (string-match-p "未更新：本次读取失败，保留上次成功读取的历史" (buffer-string)))
        (org-workflow-history-panel-refresh)
        (should (eq 'ready (plist-get org-workflow-history-panel--model :state)))
        (should-not (plist-get org-workflow-history-panel--model :error))
        (should-not (string-match-p "未更新：" (buffer-string)))))))
(ert-deftest workflow-history-panel-refresh-quit-restores-complete-model ()
  (dolist (state '(ready stale empty error))
    (let ((payload (if (memq state '(empty error)) (workflow-history-view-test--payload)
                     (workflow-history-view-test--payload (workflow-history-view-test--day "2026-09-16")))))
      (cl-letf (((symbol-function 'org-workflow-history-panel--wide-p) (lambda () nil)))
        (workflow-history-view-test--panel payload
        (when (memq state '(stale error))
          (cl-letf (((symbol-function 'org-workflow-history-read)
                     (lambda (&rest _) (error "旧读取错误"))))
            (when (eq state 'error) (setq org-workflow-history-panel--model nil))
            (org-workflow-history-panel-refresh)))
        (should (eq state (plist-get org-workflow-history-panel--model :state)))
        (let ((before org-workflow-history-panel--model)
              (text (buffer-substring-no-properties (point-min) (point-max)))
              (reads 0) (caught nil))
          (workflow-history-test--no-writes
            (cl-letf (((symbol-function 'org-workflow-history-read)
                       (lambda (&rest _)
                         (cl-incf reads)
                         (should org-workflow-history-panel--reading)
                         (should (eq 'loading (plist-get org-workflow-history-panel--model :state)))
                         (org-workflow-history-panel-refresh)
                         (signal 'quit nil))))
              (condition-case nil (org-workflow-history-panel-refresh) (quit (setq caught t)))))
          (should caught)
          (should (= reads 1))
          (should-not org-workflow-history-panel--reading)
          (should (eq before org-workflow-history-panel--model))
          (should (equal text (buffer-substring-no-properties (point-min) (point-max))))
          (dolist (text '("正在刷新历史" "正在读取历史"))
            (should-not (string-match-p text (buffer-string))))))))))

(ert-deftest workflow-history-panel-refresh-quit-initial-retry ()
  (let ((reads 0) (caught nil))
    (unwind-protect
        (progn
          (workflow-history-test--no-writes
            (cl-letf (((symbol-function 'display-buffer) #'ignore)
                      ((symbol-function 'org-workflow-history-read)
                       (lambda (&rest _)
                         (cl-incf reads)
                         (should org-workflow-history-panel--reading)
                         (signal 'quit nil))))
              (condition-case nil (org-workflow-history-panel) (quit (setq caught t)))))
          (should caught)
          (should (= reads 1))
          (with-current-buffer "*Workflow History*"
            (should-not org-workflow-history-panel--reading)
            (should (eq 'error (plist-get org-workflow-history-panel--model :state)))
            (should (string-match-p "读取已取消" (buffer-string)))
            (should (string-match-p "刷新历史" (buffer-string)))
            (should-not (string-match-p "正在读取历史" (buffer-string)))
            (should-not (string-match-p "历史摘要" (buffer-string)))
            (workflow-history-test--no-writes
              (cl-letf (((symbol-function 'org-workflow-history-read)
                         (lambda (&rest _) (cl-incf reads) (workflow-history-view-test--payload))))
                (org-workflow-history-panel-refresh)))
            (should (= reads 2))
            (should (eq 'empty (plist-get org-workflow-history-panel--model :state)))
            (should-not (plist-get org-workflow-history-panel--model :error))))
      (when (get-buffer "*Workflow History*") (kill-buffer "*Workflow History*")))))

