(ert-deftest workflow-history-read-current-parity ()
  (workflow-history-test--store
    (org-workflow-store--db)
    (org-workflow-store-set-meta "anchor" "2026-09-15")
    (org-workflow-store-put-day "2026-09-15" workflow-history-test--day)
    (org-workflow-store-put-leave '(:id "leave" :date "2026-09-16" :reason "休息"))
    (let* ((expected (org-workflow-web-export--payload workflow-history-test--now))
           (db org-workflow-store--connection)
           (source (expand-file-name "source.org" directory)))
      (with-temp-file source (insert "* TODO Source\n:LOGBOOK:\nCLOCK: [2026-09-15 Tue 10:00]--[2026-09-15 Tue 10:25] => 0:25\n:END:\n"))
      (let ((source-buffer (find-file-noselect source)))
        (unwind-protect
            (with-current-buffer source-buffer
              (goto-char 3) (narrow-to-region 2 (1- (point-max)))
              (let ((facts (workflow-history-test--buffer-facts source-buffer))
                    (bytes (workflow-history-test--bytes source))
                    (db-bytes (workflow-history-test--bytes org-workflow-store-file))
                    (runtime (workflow-history-test--runtime-facts))
                    (tables (mapcar (lambda (table) (sqlite-select db (concat "SELECT * FROM " table)))
                                    '("meta" "days" "leave_records" "habit_days" "commitments" "events" "operations")))
                    (version (sqlite-select db "PRAGMA user_version"))
                    (changes (sqlite-select db "SELECT total_changes()"))
                    (decoded nil) (original-decode (symbol-function 'org-workflow-store--decode)))
                (workflow-history-test--no-writes
                  (cl-letf (((symbol-function 'org-workflow-store--decode)
                             (lambda (&rest args)
                               (setq decoded t)
                               (apply original-decode args))))
                    (let ((actual (org-workflow-history-read workflow-history-test--now)))
                      (should (equal expected actual))
                      (should (equal "missing" (plist-get (aref (plist-get actual :days) 1) :recordState)))
                      (should (equal "休息" (plist-get (aref (plist-get (aref (plist-get actual :days) 1) :leaveRecords) 0) :reason)))))
                  (should decoded)
                  (should-error (org-workflow-store--decode "#.(error \"executed\")")
                                :type 'invalid-read-syntax)
                  (should (equal runtime (workflow-history-test--runtime-facts)))
                  (should (equal version (sqlite-select db "PRAGMA user_version")))
                  (should (equal changes (sqlite-select db "SELECT total_changes()")))
                  (should (equal tables (mapcar (lambda (table) (sqlite-select db (concat "SELECT * FROM " table)))
                                               '("meta" "days" "leave_records" "habit_days" "commitments" "events" "operations"))))
                  (should (equal facts (workflow-history-test--buffer-facts source-buffer)))
                  (should (equal bytes (workflow-history-test--bytes source)))
                  (should (equal db-bytes (workflow-history-test--bytes org-workflow-store-file))))))
          (with-current-buffer source-buffer (set-buffer-modified-p nil))
          (kill-buffer source-buffer))))))

