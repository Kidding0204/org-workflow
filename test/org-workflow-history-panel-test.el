(ert-deftest workflow-history-command-tracer ()
  "Configured commands retain one buffer and never steal the caller window."
  (workflow-history-test--store
    (org-workflow-store--db)
    (org-workflow-store-set-meta "anchor" "2026-09-15")
    (org-workflow-store-put-day "2026-09-15" workflow-history-test--day)
    (let ((reader (symbol-function 'org-workflow-history-read))
          (reads 0) (displayed nil) (caller (selected-window))
          (display-policy (copy-tree display-buffer-alist))
          (shared-map (copy-keymap vui-mode-map))
          (widget-map (copy-keymap widget-keymap))
          (global-map (copy-keymap (current-global-map))))
      (save-window-excursion
        (workflow-history-test--no-writes
          (cl-letf (((symbol-function 'org-workflow-history-read)
                     (lambda (&rest args) (cl-incf reads) (apply reader args)))
                    ((symbol-function 'display-buffer)
                     (lambda (buffer &rest _)
                       (should (eq caller (selected-window)))
                       (should (buffer-local-value 'vui--root-instance buffer))
                       (setq displayed buffer))))
            (let ((buffer (org-workflow-history-panel workflow-history-test--now)))
              (should (eq buffer displayed))
              (should (= 1 reads))
              (should (eq caller (selected-window)))
              (with-current-buffer buffer
                (dolist (command '(org-workflow-history-panel org-workflow-history-panel-refresh
                                   org-workflow-history-panel-select-date org-workflow-history-panel-close))
                  (should (commandp command)))
                (should (eq #'org-workflow-history-panel-refresh (lookup-key (current-local-map) (kbd "g"))))
                (should (eq #'org-workflow-history-panel-close (lookup-key (current-local-map) (kbd "q"))))
                (dolist (binding '(("TAB" . vui-forward) ("<backtab>" . vui-backward)
                                   ("RET" . vui-activate)))
                  (should (eq (cdr binding)
                              (lookup-key (current-local-map) (kbd (car binding))))))
                (goto-char (point-min))
                (should-error (insert "edit"))
                (should-not buffer-read-only)
                (org-workflow-history-panel-select-date "2026-09-16")
                (should (= 1 reads))
                (should (equal "missing" (plist-get (plist-get org-workflow-history-panel--model :detail) :recordState)))
                (org-workflow-history-panel--publish org-workflow-history-panel--model)
                (should (= 1 reads))
                (let ((instance vui--root-instance))
                  (org-workflow-history-panel-refresh workflow-history-test--now)
                  (should (eq instance vui--root-instance)))
                (should (= 2 reads))
                (set-window-buffer caller buffer)
                (call-interactively (lookup-key (current-local-map) (kbd "q"))))
              (should (= 2 reads))
              (should (buffer-live-p buffer))
              (should-not (buffer-local-value 'vui--root-instance buffer))
              (should (eq buffer (org-workflow-history-panel workflow-history-test--now)))
              (should (= 3 reads))
              (should (buffer-local-value 'vui--root-instance buffer)))))
        (should (equal display-policy display-buffer-alist))
        (should (equal shared-map vui-mode-map))
        (should (equal widget-map widget-keymap))
        (should (equal global-map (current-global-map)))))))

