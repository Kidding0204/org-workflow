;;; org-workflow-history-panel-test.el --- Read-only panel contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'org-workflow-history)
(require 'org-workflow-history-panel nil t)
(unless (featurep 'org-workflow-history-view-test)
  (load (expand-file-name "org-workflow-history-view-test.el"
                          (file-name-directory (or load-file-name buffer-file-name))) nil t))
(unless (featurep 'org-workflow-web-export-test)
  (load (expand-file-name "org-workflow-web-export-test.el"
                          (file-name-directory (or load-file-name buffer-file-name))) nil t))

(defconst workflow-history-test--advice
  '((org-workflow-web-export--candidate-records . org-workflow-history--export-candidates)
    (org-workflow-web-export--finalized-day . org-workflow-history--export-day)
    (org-workflow-web-export--tracking-started . org-workflow-history--export-anchor)
    (org-workflow-web-export--eligible-through . org-workflow-history--export-cutoff)
    (org-workflow-web-export--days . org-workflow-history--export-leaves)
    (org-workflow-journal-finalized-record . org-workflow-history--record)))
(defconst workflow-history-test--now (encode-time 0 0 12 17 9 2026))
(defconst workflow-history-test--day
  '(:date "2026-09-15" :recordState "finalized" :commitment "met"
    :finalizedAt "2026-09-16T00:00:00+08:00" :commitmentFocusMinutes 25
    :optionalFocusMinutes 5 :focusTotalMinutes 30 :optionalCompleted 0 :minimumTasks [] :optionalTasks []))

(defmacro workflow-history-test--store (&rest body)
  (declare (indent 0) (debug t))
  `(let* ((directory (make-temp-file "history-panel-" t))
          (org-workflow-store-file (expand-file-name "facts.sqlite" directory))
          (org-workflow-store-enabled t)
          (org-workflow-store--connection nil) (org-workflow-store--path nil)
          (added nil))
     (unwind-protect
         (progn
           (dolist (pair workflow-history-test--advice)
             (unless (advice-member-p (cdr pair) (car pair))
               (advice-add (car pair) :around (cdr pair)) (push pair added)))
           ,@body)
       (dolist (pair added) (advice-remove (car pair) (cdr pair)))
       (when (org-workflow-store--live-p org-workflow-store--connection)
         (sqlite-close org-workflow-store--connection))
       (when (get-buffer "*Workflow History*") (kill-buffer "*Workflow History*"))
       (delete-directory directory t))))

(ert-deftest workflow-history-tracer-read-render ()
  (workflow-history-test--store
    (org-workflow-store--db)
    (org-workflow-store-set-meta "anchor" "2026-09-15")
    (org-workflow-store-put-day "2026-09-15" workflow-history-test--day)
    (should (fboundp 'org-workflow-history-panel))
    (let ((window (selected-window)) (displayed nil))
      (cl-letf (((symbol-function 'sqlite-execute)
                 (lambda (&rest _) (ert-fail "Read path attempted SQLite write")))
                ((symbol-function 'display-buffer)
                 (lambda (buffer &rest _)
                   (should (eq window (selected-window)))
                   (setq displayed buffer))))
        (let ((buffer (org-workflow-history-panel workflow-history-test--now)))
          (should (eq buffer displayed))
          (with-current-buffer buffer
            (should vui--root-instance)
            (should (equal "2026-09-16" (plist-get org-workflow-history-panel--model :selected-date)))
            (should (string-match-p "Workflow 历史" (buffer-string)))
            (should (string-match-p "2026-09-15.*2026-09-16" (buffer-string)))))))))

(ert-deftest workflow-history-tracer-backend-not-ready ()
  (workflow-history-test--store
    (setq org-workflow-store-file (expand-file-name "absent/facts.sqlite" directory))
    (should (fboundp 'org-workflow-history-panel))
    (cl-letf (((symbol-function 'display-buffer) #'ignore))
      (with-current-buffer (org-workflow-history-panel workflow-history-test--now)
        (should (string-match-p "无法读取历史" (buffer-string)))))
    (should-not (file-exists-p (file-name-directory org-workflow-store-file)))))

