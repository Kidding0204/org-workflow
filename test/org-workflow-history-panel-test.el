(ert-deftest workflow-history-panel-ui-list-continuation-prefix-owned ()
  (let* ((day (workflow-history-view-test--day "2026-09-16"))
         (leave (aref (workflow-history-view-test--leave "2026-09-16") 0))
         (texts (mapcar (lambda (label)
                          (propertize (concat label (make-string 80 ?长) "末尾完整")
                                      'wrap-prefix "UNTRUSTED PREFIX"
                                      'help-echo #'workflow-history-test--data-callback
                                      'keymap '(keymap (120 . workflow-history-test--data-callback))
                                      'display "HIDDEN DATA"))
                        '("承诺长标题" "可选长标题" "习惯长标题" "请假长理由" "关联长标题"))))
    (setf (plist-get (aref (plist-get day :minimumTasks) 0) :task) (nth 0 texts)
          (plist-get (aref (plist-get day :optionalTasks) 0) :task) (nth 1 texts)
          (plist-get day :habitTasks) (vector (list :task (nth 2 texts) :outcome "done" :focusMinutes 0))
          (plist-get leave :reason) (nth 3 texts)
          (plist-get (aref (plist-get leave :tasks) 0) :task) (nth 4 texts)
          (plist-get day :leaveRecords) (vector leave))
    (workflow-history-view-test--panel (workflow-history-view-test--payload day)
      (dolist (text texts)
        (workflow-history-test--inert-buffer-text text)
        (let ((from (- (point) (length text))))
          (should (equal (substring-no-properties text) (buffer-substring-no-properties from (point))))
          (cl-loop for pos from from below (point) do
                   (should (equal "  " (get-text-property pos 'wrap-prefix)))
                   (should (= 2 (string-width (get-text-property pos 'wrap-prefix))))
                   (should-not (get-text-property pos :wrap-prefix)))))
      (dolist (label '("任务状态：" "承诺履行：" "请假 · "))
        (goto-char (point-min))
        (search-forward label)
        (should (equal "  " (get-text-property (match-beginning 0) 'wrap-prefix)))))))

(defun workflow-history-test--bytes (file)
  (with-temp-buffer
    (set-buffer-multibyte nil) (insert-file-contents-literally file) (buffer-string)))

(defun workflow-history-test--buffer-facts (buffer)
  (with-current-buffer buffer
    (list (save-restriction (widen) (buffer-substring-no-properties (point-min) (point-max)))
          (buffer-modified-p) (point) (point-min) (point-max))))

(defun workflow-history-test--runtime-facts ()
  (mapcar (lambda (symbol) (cons symbol (and (boundp symbol) (copy-tree (symbol-value symbol)))))
          '(org-clock-marker org-clock-hd-marker org-clock-start-time org-clock-current-task
            org-workflow-history-timer org-workflow-history--refresh-timer
            org-workflow-journal-seal-timer org-workflow-web-export--timer
            timer-list timer-idle-list org-clock-out-hook org-clock-in-hook
            org-workflow-journal-finalized-hook org-workflow-habits-saved-hook
            after-save-hook clone-indirect-buffer-hook org-workflow-store-enabled org-workflow-store--path
            org-workflow-store--connection)))

(defun workflow-history-test--presentation-hook-p (hook function)
  "Only the two lifecycle-managed chart observers are permitted globally."
  (and (memq hook '(enable-theme-functions disable-theme-functions))
       (eq function #'org-workflow-history-panel--theme-changed)))
(defmacro workflow-history-test--no-writes (&rest body)
  (declare (indent 0) (debug t))
  `(let ((native-comp-enable-subr-trampolines nil))
     (let ((original-add-hook (symbol-function 'add-hook))
           (original-remove-hook (symbol-function 'remove-hook)))
     (cl-letf (((symbol-function 'add-hook)
                (lambda (hook function &optional depth local)
                  (let ((before (and (boundp hook) (copy-tree (default-value hook)))))
                    (unless (or local (member function before) (workflow-history-test--presentation-hook-p hook function))
                      (ert-fail (format "Forbidden global hook addition: %S" hook)))
                    (prog1 (funcall original-add-hook hook function depth local)
                      (unless (or local (workflow-history-test--presentation-hook-p hook function))
                        (should (equal before (default-value hook))))))))
              ((symbol-function 'remove-hook)
                (lambda (hook function &optional local)
                  (unless (or local (workflow-history-test--presentation-hook-p hook function))
                    (ert-fail "Forbidden global hook removal"))
                  (funcall original-remove-hook hook function local)))
              ,@(mapcar
              (lambda (symbol)
                `((symbol-function ',symbol)
                  (lambda (&rest _) (ert-fail ,(format "Forbidden read-side call: %s" symbol)))))
