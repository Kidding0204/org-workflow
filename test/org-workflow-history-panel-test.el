(defvar workflow-history-test--data-callback-count 0)
(defun workflow-history-test--data-callback (&rest _)
  (interactive)
  (cl-incf workflow-history-test--data-callback-count))
(defun workflow-history-test--active-text (text)
  "Make serializable data properties, including an unfamiliar property."
  (propertize text 'keymap '(keymap (120 . workflow-history-test--data-callback))
              'help-echo #'workflow-history-test--data-callback
              'display "HIDDEN DATA" 'face 'error 'invisible t
              'workflow-history-data-property 'must-not-render))
(defun workflow-history-test--inert-buffer-text (text)
  "Assert ordinary TEXT is visible and no data properties reached its range."
  (goto-char (point-min))
  (search-forward (substring-no-properties text))
  (cl-loop for pos from (- (point) (length text)) below (point) do
           (dolist (property '(help-echo display invisible workflow-history-data-property))
             (should-not (get-text-property pos property)))
           (should-not (eq #'workflow-history-test--data-callback
                           (key-binding (kbd "x") nil nil pos)))
           (should-not (eq 'error (get-text-property pos 'face)))))

