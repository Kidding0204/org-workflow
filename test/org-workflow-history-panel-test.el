(ert-deftest workflow-history-panel-refresh-reopen-one-read-and-external-update ()
  (let ((payload (workflow-history-view-test--payload (workflow-history-view-test--day "2026-09-16"))))
    (workflow-history-view-test--panel payload
      (let ((reads 0) (updates nil) (original (symbol-function 'vui-update)))
        (cl-letf (((symbol-function 'org-workflow-history-read) (lambda (&rest _) (cl-incf reads) payload))
                  ((symbol-function 'vui-update)
                   (lambda (instance props)
                     (should (eq instance vui--root-instance))
                     (should (equal '(:model) (cl-loop for (k _v) on props by #'cddr collect k)))
                     (push (plist-get props :model) updates)
                     (funcall original instance props))))
          (org-workflow-history-panel)
          (should (= 1 reads))
          (should (= 1 (cl-count 'ready updates :key (lambda (m) (plist-get m :state)))))
          (setq reads 0 updates nil)
          (org-workflow-history-panel-refresh)
          (should (= 1 reads))
          (should (= 1 (cl-count 'ready updates :key (lambda (m) (plist-get m :state))))))))))

