(defun workflow-history-test--action-facts (db source buffer absent)
  "Exact business and global facts, excluding panel presentation."
  (list
   (mapcar (lambda (file) (list file (file-exists-p file)
                                (and (file-exists-p file) (workflow-history-test--bytes file))))
           (list org-workflow-store-file source absent
                 (concat org-workflow-store-file "-wal")
                 (concat org-workflow-store-file "-shm")))
   (sqlite-select db "PRAGMA user_version")
   (sqlite-select db "SELECT total_changes()")
   (mapcar (lambda (table) (sqlite-select db (concat "SELECT * FROM " table " ORDER BY rowid")))
           '("meta" "days" "leave_records" "habit_days" "commitments" "events" "operations"))
   (workflow-history-test--buffer-facts buffer)
   (workflow-history-test--runtime-facts)
   (selected-window) (copy-tree display-buffer-alist)
   (copy-keymap vui-mode-map) (copy-keymap widget-keymap)
   (copy-keymap (current-global-map))))

(ert-deftest workflow-history-read-only-panel-action-matrix ()
  "Each action retains real SELECT/decode and its own exact before/after snapshot."
  (workflow-history-test--store
    (org-workflow-store--db)
    (org-workflow-store-set-meta "anchor" "2026-09-15")
    (org-workflow-store-put-day "2026-09-15" workflow-history-test--day)
    (let* ((db org-workflow-store--connection)
           (source (expand-file-name "source.org" directory))
           (absent (expand-file-name "absent.org" directory))
           (reader (symbol-function 'org-workflow-history-read))
           (reads 0) (fail nil) (panel nil))
      (with-temp-file source (insert "* TODO Chinese source 中文\n:LOGBOOK:\nCLOCK: [2026-09-15 Tue 10:00]--[2026-09-15 Tue 10:25] => 0:25\n:END:\n"))
      (let ((source-buffer (find-file-noselect source)))
        (unwind-protect
            (progn
              (with-current-buffer source-buffer
                (goto-char 6) (narrow-to-region 2 (1- (point-max)))
                (set-buffer-modified-p t))
              (save-window-excursion
                (workflow-history-test--no-writes
                  (cl-letf (((symbol-function 'org-workflow-history-read)
                             (lambda (&rest _) (cl-incf reads)
                               (if fail (error "Synthetic read failure")
                                 (funcall reader workflow-history-test--now)))))
                    (cl-labels ((action (label count function)
                                  (ert-info ((format "Action: %s" label))
                                    (let ((before (workflow-history-test--action-facts db source source-buffer absent))
                                          (read-before reads))
                                      (funcall function)
                                      (should (= count (- reads read-before)))
                                      (should (equal before (workflow-history-test--action-facts db source source-buffer absent)))))))
                      (setq fail t)
                      (action 'first-error 1 (lambda () (setq panel (org-workflow-history-panel))))
                      (with-current-buffer panel
                        (should (eq 'error (plist-get org-workflow-history-panel--model :state))))
                      (setq fail nil)
                      (action 'first-recovery 1 (lambda () (with-current-buffer panel (org-workflow-history-panel-refresh))))
                      (action 'select-finalized 0 (lambda () (with-current-buffer panel (org-workflow-history-panel-select-date "2026-09-15"))))
                      (action 'select-missing 0 (lambda () (with-current-buffer panel (org-workflow-history-panel-select-date "2026-09-16"))))
                      (action 'cancel 0 (lambda () (with-current-buffer panel
                                                   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil))))
                                                     (call-interactively #'org-workflow-history-panel-select-date)))))
                      (action 'render 0 (lambda () (with-current-buffer panel (org-workflow-history-panel--publish org-workflow-history-panel--model))))
                      (action 'refresh 1 (lambda () (with-current-buffer panel (org-workflow-history-panel-refresh))))
                      (setq fail t)
                      (action 'stale-failure 1 (lambda () (with-current-buffer panel (org-workflow-history-panel-refresh))))
                      (with-current-buffer panel (should (eq 'stale (plist-get org-workflow-history-panel--model :state))))
                      (setq fail nil)
                      (action 'g-recovery 1 (lambda () (with-current-buffer panel (call-interactively (lookup-key (current-local-map) (kbd "g"))))))
                      (set-window-buffer (selected-window) panel)
                      (action 'q-close 0 (lambda () (with-current-buffer panel (call-interactively (lookup-key (current-local-map) (kbd "q"))))))
                      (should-not (buffer-local-value 'vui--root-instance panel))
                      (action 'reopen 1 (lambda () (should (eq panel (org-workflow-history-panel)))))
                      (action 'kill 0 (lambda () (kill-buffer panel)))
                      (should-not (buffer-live-p panel))
                      (action 'open-after-kill 1 (lambda () (setq panel (org-workflow-history-panel)))))))))
          (with-current-buffer source-buffer (set-buffer-modified-p nil))
          (kill-buffer source-buffer))))))

(ert-deftest workflow-history-command-package-registration ()
  "History entry points are available without a personal init file."
  (should (featurep 'org-workflow))
  (should (commandp 'org-workflow-history-panel))
  (should (commandp 'org-workflow-history-tracking))
  (should (commandp 'org-workflow-history-workbench)))

(ert-deftest workflow-history-command-outside-panel ()
  "Public controllers cannot replace or unmount a different vui buffer."
  (with-temp-buffer
    (let ((vui-mode-map (copy-keymap vui-mode-map))) (vui-mode))
    (insert "unrelated")
    (let ((before (buffer-string)))
      (dolist (command '(org-workflow-history-panel-refresh
                         org-workflow-history-panel-select-date
                         org-workflow-history-panel-close))
        (should-error (call-interactively command) :type 'user-error)
        (should (equal before (buffer-string)))))))
