;;; org-workflow-inbox-archive-test.el --- Daily Inbox cleanup -*- lexical-binding: t; -*-
(require 'ert)
(load "org-workflow-sources-test" nil t)

(ert-deftest workflow-inbox-archive-done-preserves-trees-and-is-idempotent ()
  (workflow-source-test
   (let ((org-id-locations-file (expand-file-name "ids" directory))
         (org-id-locations (make-hash-table :test #'equal))
         (org-id-files nil)
         (org-archive-location "%s_archive::"))
     (with-temp-file org-workflow-projects-file
       (insert "* Inbox\n** DONE Finished\nCLOSED: [2026-10-09 Fri 20:00]\n:PROPERTIES:\n:ID: archived-task\n:CAPTURED_ON: 2026-10-01\n:END:\nBody preserved.\n:LOGBOOK:\nCLOCK: [2026-10-09 Fri 19:00]--[2026-10-09 Fri 19:25] => 0:25\n:END:\n*** DONE Detail\n** TODO Keep\n*** DONE Nested\n** HOLD Held\n** DONE Today\nCLOSED: [2026-10-10 Sat 10:00]\n* Other\n** DONE Outside\n"))
     (should (= 1 (org-workflow-inbox-archive-done "2026-10-09")))
     (should-not (org-workflow-inbox-archive-done "2026-10-09"))
     (let ((marker (org-id-find "archived-task" 'marker)))
       (should (equal (concat org-workflow-projects-file "_archive")
                      (buffer-file-name (marker-buffer marker))))
       (set-marker marker nil))
     (with-temp-buffer
       (insert-file-contents (concat org-workflow-projects-file "_archive"))
       (dolist (text '("Finished" "archived-task" "CAPTURED_ON: 2026-10-01" "Body preserved." "CLOCK:" "Detail"))
         (should (string-match-p text (buffer-string)))))
     (with-temp-buffer
       (insert-file-contents org-workflow-projects-file)
       (should-not (string-match-p "Finished" (buffer-string)))
       (dolist (text '("Keep" "Nested" "Held" "Today" "Outside"))
         (should (string-match-p text (buffer-string))))))))

(ert-deftest workflow-inbox-archive-defers-unsaved-source ()
  (workflow-source-test
   (with-temp-file org-workflow-projects-file (insert "* Inbox\n** DONE Done\n"))
   (with-current-buffer (find-file-noselect org-workflow-projects-file)
     (goto-char (point-max)) (insert "Unsaved note.\n")
     (should (= 0 (org-workflow-inbox-archive-done "2026-10-09")))
     (should (buffer-modified-p))
     (should (string-match-p "Done" (buffer-string))))))

(ert-deftest workflow-inbox-archive-destination-save-failure-keeps-source ()
  (workflow-source-test
   (with-temp-file org-workflow-projects-file (insert "* Inbox\n** DONE Done\n"))
   (let ((save (symbol-function 'save-buffer)))
     (cl-letf (((symbol-function 'save-buffer)
                (lambda (&rest args)
                  (if (string-suffix-p "_archive" (or buffer-file-name ""))
                      (error "Archive write failed") (apply save args)))))
       (should-error (org-workflow-inbox-archive-done "2026-10-09")))
     (with-current-buffer (find-file-noselect org-workflow-projects-file)
       (should (string-match-p "DONE Done" (buffer-string)))))))

(ert-deftest workflow-inbox-archive-runs-after-all-days-and-not-after-seal-failure ()
  (let (events)
    (cl-letf (((symbol-function 'org-workflow-store-meta) (lambda (_) "2026-10-08"))
              ((symbol-function 'org-workflow-target--today-string) (lambda () "2026-10-10"))
              ((symbol-function 'org-workflow-history-finalize) (lambda (date) (push date events)))
              ((symbol-function 'org-workflow-inbox-archive-done) (lambda (date) (push (concat "archive:" date) events))))
      (org-workflow-history-catch-up)
      (should (equal '("2026-10-08" "2026-10-09" "archive:2026-10-09") (nreverse events)))
      (setq events nil)
      (cl-letf (((symbol-function 'org-workflow-history-finalize) (lambda (_) (error "Seal failed"))))
        (should-error (org-workflow-history-catch-up))
        (should-not events)))))

(ert-deftest workflow-inbox-archive-source-save-failure-preserves-disk-copies ()
  (workflow-source-test
   (let ((org-id-locations-file (expand-file-name "ids" directory))
         (org-id-locations (make-hash-table :test #'equal))
         (org-id-files nil))
     (with-temp-file org-workflow-projects-file (insert "* Inbox\n** DONE Done\n"))
     (let ((save (symbol-function 'save-buffer)))
       (cl-letf (((symbol-function 'save-buffer)
                  (lambda (&rest args)
                    (if (equal buffer-file-name org-workflow-projects-file)
                        (error "Source write failed") (apply save args)))))
         (should-error (org-workflow-inbox-archive-done "2026-10-09")))
       (dolist (file (list org-workflow-projects-file (concat org-workflow-projects-file "_archive")))
         (with-temp-buffer (insert-file-contents file)
                           (should (string-match-p "DONE Done" (buffer-string)))))))))

(ert-deftest workflow-inbox-archive-defers-unsaved-destination ()
  (workflow-source-test
   (with-temp-file org-workflow-projects-file (insert "* Inbox\n** DONE Done\n"))
   (with-current-buffer (find-file-noselect (concat org-workflow-projects-file "_archive"))
     (insert "Unsaved archive notes.\n"))
   (should (= 0 (org-workflow-inbox-archive-done "2026-10-09")))
   (with-temp-buffer (insert-file-contents org-workflow-projects-file)
                     (should (string-match-p "DONE Done" (buffer-string))))))
