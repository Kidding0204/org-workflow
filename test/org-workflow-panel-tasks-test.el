;;; org-workflow-panel-tasks-test.el --- Desktop task stack -*- lexical-binding: t; -*-
(require 'ert)
(require 'org-workflow-core)
(require 'org-workflow-panel)
(require 'org-workflow-focus-timer)

(ert-deftest workflow-panel-task-list-selects-real-stack-without-starting-timer ()
  (let* ((file (make-temp-file "workflow-panel-tasks-" nil ".org"
                              "#+filetags: :project:\n* Fixture\n** DIVE Work\n*** TODO Same\nSCHEDULED: <2026-10-16 Fri>\nFirst notes\n*** TODO Same\nSCHEDULED: <2026-10-16 Fri>\nSecond notes\n*** TODO Future\nSCHEDULED: <2026-10-17 Sat>\n*** DONE Finished\n"))
         (org-agenda-files (list file))
         (org-workflow-target-stack nil) (org-workflow-target-selected-marker nil)
         (org-workflow-target-selected-date nil) (org-workflow-executing-marker nil)
         (org-workflow-habit-selection nil) (org-workflow-current-changed-hook nil)
         (org-workflow-stack-empty-hook nil) stopped started)
    (unwind-protect
        (cl-letf (((symbol-function 'org-workflow-target--today-string) (lambda () "2026-10-16"))
                  ((symbol-function 'current-time) (lambda () (encode-time 0 0 20 16 10 2026)))
                  ((symbol-function 'org-workflow--request-gnome-refresh) #'ignore)
                  ((symbol-function 'org-workflow-clock--clock-active-p) (lambda () t))
                  ((symbol-function 'org-workflow-clock--clock-matches-p) (lambda (_) t))
                  ((symbol-function 'org-workflow-clock--clock-stop) (lambda () (setq stopped t)))
                  ((symbol-function 'org-workflow-clock--clock-start) (lambda (&rest _) (setq started t))))
          (let* ((entries (org-workflow-target--ordered-entries))
                 (first (org-workflow-target-entry-marker (car entries)))
                 (second (org-workflow-target-entry-marker (cadr entries))))
            (setq org-workflow-executing-marker (copy-marker first))
            (let* ((rows (org-workflow-panel--tasks first))
                   (key (plist-get (aref rows 1) :key)))
              (should (= 2 (length rows)))
              (should-not (equal (plist-get (aref rows 0) :key) key))
              (should (eq t (plist-get (aref rows 0) :selected)))
              (org-workflow-panel-select-task key)
              (should stopped)
              (should-not started)
              (should (equal org-workflow-target-selected-marker second))
              (should (string-match-p "Second notes" (org-workflow-item-body (org-workflow-current-item))))
              ;; A row that was completed after rendering must not switch targets.
              (let ((old-selection org-workflow-target-selected-marker))
                (org-with-point-at first (org-todo "DONE"))
                (should-error (org-workflow-panel-select-task (plist-get (aref rows 0) :key)) :type 'user-error)
                (should (equal org-workflow-target-selected-marker old-selection))))))
      (when-let* ((buffer (get-file-buffer file)))
        (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))
      (delete-file file))))
