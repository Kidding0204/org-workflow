(ert-deftest org-workflow-workbench-quit-from-companion-restores-original-windows ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (delete-other-windows)
    (let ((original (get-buffer-create "*Workbench original*")))
      (switch-to-buffer original)
      (org-workflow-workbench-test-open)
      (pcase-let* ((`(,primary ,candidate) (org-workflow-workbench-test-panes))
                   (window (get-buffer-window candidate)))
        (select-window window)
        (org-agenda-quit)
        (should (= 1 (length (window-list))))
        (should (eq original (window-buffer (selected-window))))
        (should-not (buffer-live-p primary))
        (should-not (buffer-live-p candidate))))))

(ert-deftest org-workflow-workbench-journal-entry-quit-restores-original-windows ()
  (require 'vulpea-journal)
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (delete-other-windows)
    (let* ((journal (find-file-noselect (car files)))
           (journal-window (selected-window))
           (unrelated (get-buffer-create "*Journal unrelated*"))
           (other-window (split-window-below))
           (org-workflow-store-enabled nil)
           (org-workflow-collection--opening-sprint nil)
           (note (make-vulpea-note :path (car files))))
      (set-window-buffer other-window unrelated)
      (switch-to-buffer journal)
      (let ((noninteractive nil))
        (cl-letf (((symbol-function 'vulpea-journal-find-note) (lambda (&rest _) note))
                  ((symbol-function 'vulpea-journal-active-date)
                   (lambda () (encode-time 0 0 20 17 8 2026))))
          (org-workflow-collection-show-sprint)))
      (should (eq journal-window (selected-window)))
      (should (eq journal (current-buffer)))
      (should (= 3 (length (window-list))))
      (let* ((sprint (get-buffer "*日记 Sprint*"))
             (sprint-window (get-buffer-window sprint)))
        (should (buffer-live-p sprint))
        (with-current-buffer sprint
          (should (eq 'combined org-workflow-agenda--pane-role))
          (should-not (org-workflow-agenda--setting 'org-workflow-agenda-columns-enabled)))
        (select-window sprint-window)
        (org-agenda-quit)
        (should-not (buffer-live-p sprint)))
      (should (= 2 (length (window-list))))
      (should (eq journal-window (selected-window)))
      (should (eq journal (window-buffer journal-window)))
      (should (eq unrelated (window-buffer other-window))))))

(ert-deftest org-workflow-workbench-redo-restores-task-and-group-anchor ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (pcase-let ((`(,_primary ,candidate) (org-workflow-workbench-test-panes)))
      (with-current-buffer candidate
        (let ((id (cadr (car (org-workflow-agenda--candidate-entries)))))
          (org-workflow-agenda--set-setting 'org-workflow-agenda-selected-group id)
          (org-agenda-redo)
          (goto-char (point-min)) (search-forward "Second") (beginning-of-line)
          (let* ((window (get-buffer-window candidate))
                 (marker (copy-marker (org-get-at-bol 'org-hd-marker))))
            (set-window-start window (point) t)
            (set-window-point window (point))
            (org-agenda-redo)
            (should (equal id (org-workflow-agenda--setting 'org-workflow-agenda-selected-group)))
            (should (equal marker (org-get-at-bol 'org-hd-marker)))
                                            (should (equal marker (get-text-property (window-start window) 'org-hd-marker)))
                                            (set-marker marker nil)))))))

(ert-deftest org-workflow-workbench-explicit-tab-restores-original-workspace ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
                                    (delete-other-windows)
                                    (let* ((original (get-buffer-create "*Workbench original workspace*"))
                                           (unrelated (get-buffer-create "*Workbench unrelated workspace*"))
                                           (count (length (funcall tab-bar-tabs-function)))
                                           state)
                                      (switch-to-buffer original)
                                      (set-window-buffer (split-window-below) unrelated)
                                      (unwind-protect
                                          (progn
                                            (org-workflow-agenda-open-workbench)
                                            (setq state org-workflow-agenda--workbench)
                                            (should (= (1+ count) (length (funcall tab-bar-tabs-function))))
                                            (let* ((primary (org-workflow-agenda-workbench-primary state))
                                                   (candidate (org-workflow-agenda-workbench-candidates state))
                                                   (left (get-buffer-window primary))
                                                   (right (get-buffer-window candidate)))
                                              (should (< (car (window-edges left)) (car (window-edges right))))
                                              (with-current-buffer candidate
                                                (should tab-line-mode)
                                                (should (eq tab-line-tabs-function #'org-workflow-agenda-candidate-tabs)))
                                              (select-window right)
                                              (org-agenda-quit)
                                              (should-not (buffer-live-p primary))
                                              (should-not (buffer-live-p candidate)))
                                            (should (= count (length (funcall tab-bar-tabs-function))))
                                            (should (= 2 (length (window-list))))
                                            (should (eq original (window-buffer (selected-window))))
                                            (should (get-buffer-window unrelated)))
                                        (when (alist-get 'org-workflow-agenda-workbench (tab-bar--current-tab-find))
                                          (tab-bar-close-tab))))))

