;;; org-workflow-agenda-workbench-test.el --- Sprint workbench regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'org-workflow-agenda)
(require 'org-workflow-core)

(defmacro org-workflow-workbench-test-with-files (contents &rest body)
  (declare (indent 1))
  `(let ((files nil)
         (before-buffers (buffer-list))
         (org-agenda-buffer-name (generate-new-buffer-name "*Sprint test*"))
         (org-agenda-window-setup 'current-window)
         (org-workflow-agenda-plan-tomorrow nil)
         (org-workflow-agenda-selected-group nil)
         (org-workflow-agenda-planning-all nil)
         (org-workflow-agenda-future-expanded t)
         (org-workflow-agenda-columns-enabled nil))
     (unwind-protect
         (save-window-excursion
           (dolist (content ,contents)
             (push (make-temp-file "workbench-" nil ".org" content) files))
           (setq files (nreverse files))
           (let ((org-agenda-files files))
             (cl-letf (((symbol-function 'org-workflow-target--today-string)
                        (lambda () "2026-08-17"))
                       ((symbol-function 'current-time)
                        (lambda () (encode-time 0 0 20 17 8 2026)))
                       ((symbol-function 'org-workflow-collection-inbox--review-files)
                        (lambda (&rest _) nil))
                       ((symbol-function 'org-workflow-habits--map) #'ignore))
               ,@body)))
       (dolist (buffer (seq-difference (buffer-list) before-buffers))
         (when (buffer-live-p buffer)
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (mapc #'delete-file files))))

(defconst org-workflow-workbench-test-source
  "#+filetags: :project:\n#+CATEGORY: Work\n#+TODO: TODO READY | DONE HOLD\n* Stage\n** DIVE Group\n*** TODO First :@deep:\n*** TODO Second :@flow:\n*** TODO Overdue\nSCHEDULED: <2026-08-15 Sat>\n*** TODO Today\nSCHEDULED: <2026-08-17 Mon>\n*** TODO Tomorrow\nSCHEDULED: <2026-08-18 Tue>\n*** TODO Later\nSCHEDULED: <2026-08-19 Wed>\n** DIVE Other\n*** TODO Third\n")

(defun org-workflow-workbench-test-open ()
  (org-agenda nil "d")
  (get-buffer org-agenda-buffer-name))

(defun org-workflow-workbench-test-titles (&optional buffer)
  "Read task identities from native row markers, ignoring headings."
  (with-current-buffer (or buffer (current-buffer))
    (save-excursion
      (goto-char (point-min))
      (let (titles)
        (while (< (point) (point-max))
          (when-let* ((marker (org-get-at-bol 'org-hd-marker)))
            (should (marker-buffer marker))
            (push (org-with-point-at marker (org-get-heading t t t t)) titles))
          (forward-line))
        (nreverse titles)))))

(defun org-workflow-workbench-test-panes ()
  "Create the native companion, also in batch where auto layout is disabled."
  (when-let* ((primary (and org-workflow-agenda--workbench
                            (org-workflow-agenda-workbench-primary org-workflow-agenda--workbench)))
              (window (get-buffer-window primary)))
    (select-window window))
  (delete-other-windows)
  (org-workflow-agenda--set-setting 'org-workflow-agenda-columns-enabled t)
  (let ((org-workflow-agenda-column-min-width 20)) (org-workflow-agenda--apply-columns))
  (let ((state org-workflow-agenda--workbench))
    (list (org-workflow-agenda-workbench-primary state)
          (org-workflow-agenda-workbench-candidates state))))

(ert-deftest org-workflow-workbench-candidates-source-order-and-ancestor-identity ()
  (org-workflow-workbench-test-with-files
      '("#+filetags: :project:\n#+CATEGORY: Work\n* DIVE Stage\n** Same\n*** DIVE Branch\n**** TODO Zed\n**** TODO Alpha\n** DIVE Same\n*** TODO Other\n** TODO Direct\n")
    (let* ((rows (org-workflow-agenda--candidate-entries))
           (ids (mapcar #'cadr rows)))
     (should (equal '("Zed" "Alpha" "Other" "Direct")
                    (mapcar (lambda (row) (org-workflow-target-entry-title (car row))) rows)))
     (should (equal (car ids) (cadr ids)))
     (should (equal (car ids) (nth 2 ids)))
     (should (equal "Stage" (nth 2 (car rows))))
     (should (equal "Stage" (nth 2 (nth 3 rows)))))))

(ert-deftest org-workflow-workbench-candidate-scope-excludes-held-done-and-parents ()
  (org-workflow-workbench-test-with-files
      '("#+filetags: :area:\n#+TODO: TODO READY | DONE HOLD\n* DIVE Current\n** TODO Live\n** TODO Parent\n*** DONE Child\n** READY Ready\n** HOLD Held\n*** TODO Hidden\n** TODO Scheduled\nSCHEDULED: <2026-08-18 Tue>\n* Inactive\n** TODO Backlog\n"
        "* DIVE Unscoped\n** TODO Outside\n")
    (should (equal '("Live") (mapcar (lambda (r) (org-workflow-target-entry-title (car r)))
                                     (org-workflow-agenda--candidate-entries))))
    (let ((org-workflow-agenda-planning-all t))
      (should (equal '("Live" "Backlog")
                     (mapcar (lambda (r) (org-workflow-target-entry-title (car r)))
                             (org-workflow-agenda--candidate-entries)))))))

(ert-deftest org-workflow-workbench-same-title-tabs-across-files-retain-source-order ()
  (org-workflow-workbench-test-with-files
      '("#+filetags: :project:\n#+CATEGORY: Work\n* Stage\n** DIVE Same\n*** TODO First file\n"
        "#+filetags: :project:\n#+CATEGORY: Work\n* Stage\n** DIVE Same\n*** TODO Second file\n")
    (org-workflow-workbench-test-open)
    (pcase-let ((`(,_primary ,candidate) (org-workflow-workbench-test-panes)))
      (set-buffer candidate))
    (should (equal '("First file" "Second file") (org-workflow-workbench-test-titles)))
   (let ((rows (org-workflow-agenda--candidate-entries)))
     (should-not (equal (cadar rows) (cadr (cadr rows)))))
   (dolist (file files)
     (should (seq-some (lambda (tab)
                         (string-match-p (regexp-quote (file-name-nondirectory file))
                                         (alist-get 'name tab)))
                       (org-workflow-agenda-candidate-tabs))))))

(ert-deftest org-workflow-workbench-tabs-preserve-schedule-and-source ()
  (org-workflow-workbench-test-with-files
   (list org-workflow-workbench-test-source "#+filetags: :project:\n#+CATEGORY: OtherProject\n* DIVE Stage\n** TODO Other project task\n")
   (org-workflow-workbench-test-open)
   (pcase-let* ((`(,primary ,candidate) (org-workflow-workbench-test-panes))
                (schedule (with-current-buffer primary (buffer-string)))
                (source (with-current-buffer (find-file-noselect (car files)) (buffer-string))))
     (with-current-buffer candidate
       (should (eq tab-line-tabs-function #'org-workflow-agenda-candidate-tabs))
       (funcall (alist-get 'select (car (last (org-workflow-agenda-candidate-tabs)))))
       (should (equal '("Other project task") (org-workflow-workbench-test-titles))))
     (should (equal schedule (with-current-buffer primary (buffer-string))))
     (should (equal source (with-current-buffer (find-file-noselect (car files)) (buffer-string)))))))

(ert-deftest org-workflow-workbench-day-view-exact-tomorrow-and-no-future-duplicate ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (let ((source (with-current-buffer (find-file-noselect (car files)) (buffer-string)))
          (execution (mapcar #'org-workflow-target-entry-title (org-workflow-target--ordered-entries)))
          (org-workflow-target-stack (list 'execution-cache-sentinel))
          (org-workflow-target-selected-date "2026-08-17"))
      (should (member "Overdue" (org-workflow-workbench-test-titles)))
      (org-workflow-agenda-set-day t)
      (let ((titles (org-workflow-workbench-test-titles)))
        (should-not (member "Overdue" titles))
        (should-not (member "Today" titles))
        (should (= 1 (seq-count (lambda (title) (equal title "Tomorrow")) titles)))
        (should-not (member "Later" titles)))
      (should (equal execution (mapcar #'org-workflow-target-entry-title (org-workflow-target--ordered-entries))))
      (should (equal '(execution-cache-sentinel) org-workflow-target-stack))
      (should (equal "2026-08-17" org-workflow-target-selected-date))
      (should (equal source (with-current-buffer (find-file-noselect (car files)) (buffer-string)))))))

(ert-deftest org-workflow-workbench-completed-bands-use-valid-scoped-inherited-priority ()
  (org-workflow-workbench-test-with-files
      '("#+filetags: :area:\n#+TODO: TODO READY | DONE HOLD\n* [#A] Area\n** Group\n*** DONE Finished\nCLOSED: [2026-08-17 Mon 10:00] SCHEDULED: <2026-08-16 Sun>\n*** DONE [#B] Future\nCLOSED: [2026-08-17 Mon 10:00] SCHEDULED: <2026-08-18 Tue>\n*** DONE [#B] No schedule\nCLOSED: [2026-08-17 Mon 10:00]\n*** DONE [#B] Yesterday\nCLOSED: [2026-08-16 Sun 10:00] SCHEDULED: <2026-08-16 Sun>\n** HOLD [#C] Hold\n*** DONE Hidden\nCLOSED: [2026-08-17 Mon 10:00] SCHEDULED: <2026-08-16 Sun>\n** DONE [#C] Parent\nCLOSED: [2026-08-17 Mon 10:00] SCHEDULED: <2026-08-16 Sun>\n*** TODO Child\n"
        "* Area\n** DONE [#C] Outside\nCLOSED: [2026-08-17 Mon 10:00] SCHEDULED: <2026-08-16 Sun>\n")
    (should (equal '(?A) (org-workflow-agenda--completed-periods "2026-08-17")))
    (with-temp-buffer
      (org-workflow-agenda-task-stack nil)
      (should (= 1 (how-many "已完成" (point-min) (point-max))))
      (should (= 2 (how-many "暂无安排" (point-min) (point-max)))))))

(ert-deftest org-workflow-workbench-day-switch-syncs-command-date-and-empty-context ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (pcase-let ((`(,primary ,candidate) (org-workflow-workbench-test-panes)))
      (with-current-buffer candidate (org-workflow-agenda-set-day t))
      (dolist (buffer (list primary candidate))
        (with-current-buffer buffer
          (should (equal "2026-08-18" (org-workflow-agenda-target-date)))
          (dolist (command '(org-workflow-agenda-plan-morning org-workflow-agenda-plan-afternoon org-workflow-agenda-plan-evening))
            (let (date period)
              (cl-letf (((symbol-function 'org-workflow-agenda--apply-planning) #'funcall)
                        ((symbol-function 'org-agenda-priority) (lambda (p) (setq period p)))
                        ((symbol-function 'org-agenda-schedule) (lambda (_ d) (setq date d))))
                (funcall command))
              (should (equal "2026-08-18" date))
              (should (memq period '(?A ?B ?C)))))))
      (with-current-buffer primary
        (goto-char (point-min))
        (search-forward "暂无安排")
        (beginning-of-line)
        (let (created)
          (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "New task"))
                    ((symbol-function 'org-workflow-agenda-create-task)
                     (lambda (title date period) (setq created (list title date period)))))
            (org-workflow-agenda-create-at-point))
          (should (equal '("New task" "2026-08-18" ?A) created)))))))

(ert-deftest org-workflow-workbench-native-refresh-keeps-markers-and-bulk-local ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (pcase-let ((`(,primary ,candidate) (org-workflow-workbench-test-panes)))
      (with-current-buffer candidate
        (goto-char (point-min)) (search-forward "First") (beginning-of-line)
        (org-agenda-bulk-mark)
        (should (= 1 (length org-agenda-bulk-marked-entries))))
      (with-current-buffer primary (should-not org-agenda-bulk-marked-entries))
      (with-current-buffer candidate
        (org-agenda-bulk-unmark-all)
        (goto-char (point-min)) (search-forward "First") (beginning-of-line)
        (org-agenda-schedule nil "2026-08-17")
        (org-agenda-redo)
        (should-not (member "First" (org-workflow-workbench-test-titles))))
      (should (member "First" (org-workflow-workbench-test-titles primary)))
      (with-current-buffer primary (org-agenda-redo))
      (should (member "Second" (org-workflow-workbench-test-titles candidate)))
      (should (member "First" (org-workflow-workbench-test-titles primary))))))

(ert-deftest org-workflow-workbench-native-period-planning-keeps-candidate-alive ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (pcase-let ((`(,primary ,candidate) (org-workflow-workbench-test-panes)))
      (let ((org-workflow-store-enabled nil))
        (with-current-buffer candidate
          (org-workflow-agenda-set-day t)
          (goto-char (point-min)) (search-forward "First") (beginning-of-line)
          (org-workflow-agenda-plan-morning)))
      (should (buffer-live-p candidate))
      (should (buffer-live-p primary))
      (should (eq 'candidates (buffer-local-value 'org-workflow-agenda--pane-role candidate)))
      (should-not (member "First" (org-workflow-workbench-test-titles candidate)))
      (should (member "Second" (org-workflow-workbench-test-titles candidate)))
      (should (member "First" (org-workflow-workbench-test-titles primary)))
      (with-current-buffer (find-file-noselect (car files))
        (goto-char (point-min)) (search-forward "First") (org-back-to-heading)
        (should (= ?A (nth 3 (org-heading-components))))
        (should (equal "2026-08-18"
                       (org-workflow-target--timestamp-date (org-entry-get nil "SCHEDULED"))))))))

(ert-deftest org-workflow-workbench-native-plan-undo-refreshes-both-panes ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (let* ((directory (make-temp-file "workbench-undo-" t))
           (org-workflow-store-file (expand-file-name "facts.sqlite" directory))
           (org-workflow-store--connection nil)
           (org-workflow-store--path nil)
           (org-workflow-store-enabled t)
           (org-id-locations-file (expand-file-name "ids" directory))
           (org-id-locations (make-hash-table :test #'equal))
           (org-id-files nil)
           (org-workflow-agenda-last-plan nil)
           (org-workflow-executing-marker nil)
           (org-workflow-target-selected-marker nil)
           (org-workflow-current-changed-hook nil))
      (unwind-protect
          (progn
            (org-workflow-workbench-test-open)
            (pcase-let ((`(,primary ,candidate) (org-workflow-workbench-test-panes)))
              (with-current-buffer candidate
                (org-workflow-agenda-set-day t)
                (goto-char (point-min)) (search-forward "First") (beginning-of-line)
                (org-workflow-agenda-plan-morning)
                (should org-workflow-agenda-last-plan)
                (org-workflow-agenda-undo-plan))
              (should (buffer-live-p primary))
              (should (buffer-live-p candidate))
              (should-not org-workflow-agenda-last-plan)
              (should (member "First" (org-workflow-workbench-test-titles candidate)))
              (should-not (member "First" (org-workflow-workbench-test-titles primary)))
              (with-current-buffer (find-file-noselect (car files))
                (goto-char (point-min)) (search-forward "First") (org-back-to-heading)
                (should-not (nth 3 (org-heading-components)))
                (should-not (org-entry-get nil "SCHEDULED")))))
        (when (and org-workflow-store--connection
                   (org-workflow-store--live-p org-workflow-store--connection))
          (sqlite-close org-workflow-store--connection))
        (delete-directory directory t)))))

(ert-deftest org-workflow-workbench-window-geometry-collapse-and-unrelated-pane ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (org-workflow-workbench-test-open)
    (delete-other-windows)
    (let* ((primary (current-buffer))
                                           (other (split-window-below))
                                           (unrelated (get-buffer-create "*Workbench unrelated*")))
                                      (set-window-buffer other unrelated)
                                      (org-workflow-agenda--set-setting 'org-workflow-agenda-columns-enabled t)
                                      (let ((org-workflow-agenda-column-min-width 20)) (org-workflow-agenda--apply-columns))
                                      (let* ((state org-workflow-agenda--workbench)
                                             (left (org-workflow-agenda-workbench-window state))
                                             (right (get-buffer-window primary)))
                                        (should (window-live-p left))
                                        (should (> (car (window-edges left)) (car (window-edges right))))
                                        (should (eq unrelated (window-buffer other)))
                                        (org-workflow-agenda-toggle-columns)
                                        (should-not (window-live-p left))
        (should (eq 'combined org-workflow-agenda--pane-role))
        (let ((org-workflow-agenda-column-min-width 20)) (org-workflow-agenda-toggle-columns))
        (should (window-live-p (org-workflow-agenda-workbench-window state)))
        (should (eq unrelated (window-buffer other)))))))

