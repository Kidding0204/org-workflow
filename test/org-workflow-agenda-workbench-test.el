(ert-deftest org-workflow-workbench-agenda-dispatch-and-left-tab-line ()
  (org-workflow-workbench-test-with-files (list org-workflow-workbench-test-source)
    (unwind-protect
        (progn
          (org-agenda nil "s")
          (should (eq org-workflow-agenda--pane-role 'schedule))
          (should (local-variable-p 'tab-line-format))
          (should-not tab-line-format)
          (org-workflow-agenda-set-day t)
          (should (string-match-p "明日安排" (buffer-string)))
          (should-not tab-line-format)
          (let* ((state org-workflow-agenda--workbench)
                 (candidate (org-workflow-agenda-workbench-candidates state)))
            (select-window (get-buffer-window candidate))
            (goto-char (point-min)) (search-forward "First") (beginning-of-line)
            (let ((org-workflow-store-enabled nil)) (org-workflow-agenda-plan-morning))
            (should (member "First" (org-workflow-workbench-test-titles
                                     (org-workflow-agenda-workbench-primary state)))))
          (org-agenda-quit))
      (when (alist-get 'org-workflow-agenda-workbench (tab-bar--current-tab-find))
        (tab-bar-close-tab)))))

(ert-deftest org-workflow-workbench-cleans-only-abandoned-menu-side-windows ()
  (save-window-excursion
    (delete-other-windows)
    (let* ((original (selected-window))
           (other (split-window-below))
           (edit (get-buffer-create "*Workbench preserved edit*"))
           (menu (get-buffer-create " *Old buffer  *transient**"))
           (side (display-buffer-in-side-window menu '((side . bottom)))))
      (unwind-protect
          (progn
            (set-window-buffer other edit)
            (org-workflow-agenda--clean-menu-windows)
            (should-not (window-live-p side))
            (should (window-live-p original))
            (should (eq edit (window-buffer other))))
        (kill-buffer edit)
        (kill-buffer menu)))))

