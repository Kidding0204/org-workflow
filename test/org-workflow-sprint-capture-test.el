;;; org-workflow-sprint-capture-test.el --- Daily capture contracts -*- lexical-binding: t; -*-
(require 'ert)
(load "org-workflow-store-test" nil t)
(require 'org-workflow-agenda)

(ert-deftest workflow-qa-never-replaces-parent-leaf ()
  (with-temp-buffer
    (insert "* TODO Work [0/0]\n** TODO Question :QA:\n")
    (org-mode)
    (goto-char (point-min))
    (should (org-workflow-target--task-leaf-p))
    (forward-line 1)
    (should-not (org-workflow-target--task-p))
    (org-add-planning-info 'scheduled (org-time-string-to-time "2026-09-16"))
    (should (org-workflow-target--task-p))
    (goto-char (point-min))
    (should (org-workflow-target--task-leaf-p))))

(ert-deftest workflow-qa-statistics-ignore-open-and-closed-questions ()
  (with-temp-buffer
    (insert "* TODO Work [0/0]\n** TODO Question :QA:\n")
    (org-mode)
    (goto-char (point-min)) (forward-line 1)
    (let ((org-log-done nil)) (org-todo "DONE"))
    (goto-char (point-min))
    (should (equal "TODO" (org-get-todo-state)))
    (should (looking-at-p "\\* TODO Work \\[0/0\\]"))))

(ert-deftest workflow-qa-identity-is-not-inherited ()
  (with-temp-buffer
    (insert "* TODO Container :QA:\n** TODO Real task\n")
    (org-mode) (goto-char (point-min)) (forward-line 1)
    (should-not (org-workflow-qa-p))
    (should (org-workflow-target--task-p))))

(ert-deftest workflow-capture-five-destinations-keep-context ()
  (dolist (key '("t" "qc" "qi" "nc" "ni"))
    (org-workflow-store-test
     (let ((org-workflow-projects-file file)
           (org-capture-templates nil)
           (org-capture-mode-hook nil)
           (org-capture-after-finalize-hook nil)
           (org-capture-prepare-finalize-hook nil)
           (org-capture-before-finalize-hook nil)
           (current (point-marker)))
       (org-workflow-install-inbox-capture-templates)
       (cl-letf (((symbol-function 'org-workflow-target--require-current) (lambda (&rest _) current)))
         (org-capture nil key)
         (insert "Captured question or thought")
         (org-capture-finalize))
       (with-current-buffer (find-file-noselect file)
         (goto-char (point-min))
         (search-forward "Captured question or thought") (org-back-to-heading t)
         (should (org-entry-get nil "ID"))
         (should (string-match-p "[0-9]:[0-9]" (org-entry-get nil "CAPTURED_ON")))
         (should (equal (and (member key '("t" "qc" "qi")) "TODO") (org-get-todo-state)))
         (should (equal (and (member key '("qc" "qi")) t) (and (org-workflow-qa-p) t)))
         (org-up-heading-safe)
         (should (equal (if (member key '("qc" "nc")) "Task" "Inbox") (org-get-heading t t t t))))))))

(ert-deftest workflow-inbox-excludes-plain-thoughts ()
  (org-workflow-store-test
   (erase-buffer) (insert "* Inbox\n** A thought\n** TODO A task\n** TODO A question :QA:\n")
   (org-mode)
   (let* ((org-workflow-projects-file file)
          (rows (org-workflow-collection-inbox--pending (list file) t t)))
     (should (= 2 (length rows))))))
