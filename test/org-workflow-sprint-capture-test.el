;;; org-workflow-sprint-capture-test.el --- Daily capture contracts -*- lexical-binding: t; -*-
(require 'ert)
(load "org-workflow-store-test" nil t)
(require 'org-workflow-agenda)

(ert-deftest workflow-qa-never-replaces-parent-leaf ()
  (with-temp-buffer
    (insert "* TODO Work [0/0]\n** TODO Question :QA:\n")
    (org-mode)
    (goto-char (point-min))
    (should (org-workflow-target--task-leaf-p))
    (forward-line 1)
    (should-not (org-workflow-target--task-p))
    (org-add-planning-info 'scheduled (org-time-string-to-time "2026-09-16"))
    (should (org-workflow-target--task-p))
    (goto-char (point-min))
    (should (org-workflow-target--task-leaf-p))))

(ert-deftest workflow-qa-statistics-ignore-open-and-closed-questions ()
  (with-temp-buffer
    (insert "* TODO Work [0/0]\n** TODO Question :QA:\n")
    (org-mode)
    (goto-char (point-min)) (forward-line 1)
    (let ((org-log-done nil)) (org-todo "DONE"))
    (goto-char (point-min))
    (should (equal "TODO" (org-get-todo-state)))
    (should (looking-at-p "\\* TODO Work \\[0/0\\]"))))

(ert-deftest workflow-qa-identity-is-not-inherited ()
  (with-temp-buffer
    (insert "* TODO Container :QA:\n** TODO Real task\n")
    (org-mode) (goto-char (point-min)) (forward-line 1)
    (should-not (org-workflow-qa-p))
    (should (org-workflow-target--task-p))))

(ert-deftest workflow-capture-five-destinations-keep-context ()
  (dolist (key '("t" "qc" "qi" "nc" "ni"))
    (org-workflow-store-test
     (let ((org-workflow-projects-file file)
           (org-capture-templates nil)
           (org-capture-mode-hook nil)
           (org-capture-after-finalize-hook nil)
           (org-capture-prepare-finalize-hook nil)
           (org-capture-before-finalize-hook nil)
           (current (point-marker)))
       (org-workflow-install-inbox-capture-templates)
       (cl-letf (((symbol-function 'org-workflow-target--require-current) (lambda (&rest _) current)))
         (org-capture nil key)
         (insert "Captured question or thought")
         (org-capture-finalize))
       (with-current-buffer (find-file-noselect file)
         (goto-char (point-min))
         (search-forward "Captured question or thought") (org-back-to-heading t)
         (should (org-entry-get nil "ID"))
         (should (string-match-p "[0-9]:[0-9]" (org-entry-get nil "CAPTURED_ON")))
         (should (equal (and (member key '("t" "qc" "qi")) "TODO") (org-get-todo-state)))
         (should (equal (and (member key '("qc" "qi")) t) (and (org-workflow-qa-p) t)))
         (org-up-heading-safe)
         (should (equal (if (member key '("qc" "nc")) "Task" "Inbox") (org-get-heading t t t t))))))))

(ert-deftest workflow-inbox-excludes-plain-thoughts ()
  (org-workflow-store-test
   (erase-buffer) (insert "* Inbox\n** A thought\n** TODO A task\n** TODO A question :QA:\n")
   (org-mode)
   (let* ((org-workflow-projects-file file)
          (rows (org-workflow-collection-inbox--pending (list file) t t)))
     (should (= 2 (length rows))))))

(ert-deftest workflow-anytime-four-per-project-source-order-and-qa-dedup ()
  (org-workflow-store-test
   (let ((org-workflow-projects-file file))
     (erase-buffer)
     (insert "* DIVE Project\n** TODO First stage\n*** TODO One\n**** TODO Pending question :QA:\n*** TODO Two\n*** TODO Planned\nSCHEDULED: <2026-09-17 Thu>\n** TODO Second stage\n*** TODO Three\n*** TODO Four\n*** TODO Five\n* HOLD Paused\n** TODO Stage\n*** TODO Hidden\n* Inbox\n** A thought\n** TODO Inbox question :QA:\n")
     (org-mode)
     (let ((org-workflow-agenda-plan-tomorrow nil))
       (with-temp-buffer
         (org-agenda-mode)
         (let ((inhibit-read-only t)) (org-workflow-agenda-inbox nil nil))
         (let ((text (buffer-string)))
           (should (string-match-p "随时" text))
           (should (string-match-p "One\\(.\\|\n\\)*Two\\(.\\|\n\\)*Three\\(.\\|\n\\)*Four" text))
           (should-not (string-match-p "Five\\|Planned\\|Hidden\\|A thought" text))
           (should (= 1 (how-many "Inbox question" (point-min) (point-max))))
           (should (= 1 (how-many "Pending question" (point-min) (point-max))))))))))

(ert-deftest workflow-sprint-edit-returns-to-source-backed-row ()
  (org-workflow-store-test
   (let ((source (current-buffer)) (marker (point-marker)) (origin (get-buffer-create "*wf-edit-test*")))
     (unwind-protect
         (save-window-excursion
           (switch-to-buffer origin)
           (org-agenda-mode)
           (let ((inhibit-read-only t))
             (insert (propertize "Task\n" 'org-hd-marker marker 'org-marker marker)))
           (goto-char (point-min))
           (org-workflow-agenda-edit-source)
           (should (eq (buffer-base-buffer) source))
           (goto-char (point-max)) (insert "Answer\n")
           (org-workflow-agenda-edit-finish)
           (should (eq (current-buffer) origin))
           (should (with-current-buffer source (string-match-p "Answer" (buffer-string)))))
       (kill-buffer origin)))))

(ert-deftest workflow-daily-only-explicit-today-first-source-task ()
  (org-workflow-store-test
   (erase-buffer)
   (insert "* DIVE Project\n:PROPERTIES:\n:ID: p\n:END:\n** TODO Stage\n*** TODO Unscheduled\n*** TODO First\nSCHEDULED: <2026-09-16 Wed>\n*** TODO Second\nSCHEDULED: <2026-09-16 Wed>\n")
   (org-mode)
   (org-workflow-projects-sync)
   (let ((id (caar (org-workflow-store-due "2026-09-16"))))
     (should (equal "First" (nth 5 (org-workflow-store-commitment id))))
     (goto-char (point-min)) (search-forward "*** TODO First") (beginning-of-line)
     (let ((org-log-done nil)) (org-todo "DONE"))
     (org-workflow-projects-sync)
     (should (= 1 (length (org-workflow-store-due "2026-09-16"))))
     (should (equal id (org-workflow-store-meta "project-day:2026-09-16:p"))))))

(ert-deftest workflow-daily-no-plan-no-obligation-or-schedule ()
  (org-workflow-store-test
   (erase-buffer) (insert "* DIVE Project\n** TODO Stage\n*** TODO Later\n") (org-mode)
   (org-workflow-projects-sync)
   (should-not (org-workflow-store-due "2026-09-16"))
   (should-not (string-match-p "SCHEDULED" (buffer-string)))))

(ert-deftest workflow-daily-manual-replacement-and-withdrawal-stay-fixed ()
  (org-workflow-store-test
   (erase-buffer)
   (insert "* DIVE Project\n:PROPERTIES:\n:ID: p\n:END:\n** TODO Stage\n*** TODO First\nSCHEDULED: <2026-09-16 Wed>\n*** TODO Second\nSCHEDULED: <2026-09-16 Wed>\n") (org-mode)
   (org-workflow-projects-sync)
   (let ((old (org-workflow-store-meta "project-day:2026-09-16:p")))
     (goto-char (point-min)) (search-forward "*** TODO Second") (beginning-of-line)
     (org-workflow-toggle-commitment)
     (let ((new (org-workflow-store-meta "project-day:2026-09-16:p")))
       (should-not (equal old new))
       (should (equal "withdrawn" (nth 6 (org-workflow-store-commitment old))))
       (org-workflow-projects-sync)
       (should (equal new (org-workflow-store-meta "project-day:2026-09-16:p")))
       (org-workflow-toggle-commitment)
       (org-workflow-projects-sync)
       (should (equal new (org-workflow-store-meta "project-day:2026-09-16:p")))
       (should (equal "withdrawn" (nth 6 (org-workflow-store-commitment new))))))))

(ert-deftest workflow-daily-tomorrow-planning-does-not-create-a-draft ()
  (org-workflow-store-test
   (erase-buffer) (insert "* DIVE Project\n** TODO Stage\n*** TODO Tomorrow\n") (org-mode)
   (goto-char (point-max)) (org-back-to-heading t)
   (org-schedule nil "2026-09-17")
   (should-not (org-workflow-store-due "2026-09-17"))
   (should-not (org-workflow-store-due "2026-09-16"))
   (cl-letf (((symbol-function 'org-workflow-target--today-string) (lambda () "2026-09-17")))
     (org-workflow-projects-sync)
     (should (= 1 (length (org-workflow-store-due "2026-09-17")))))))

(ert-deftest workflow-qa-scheduling-preserves-current-task ()
  (org-workflow-store-test
   (erase-buffer)
   (insert "* DIVE Project\n** TODO Stage\n*** TODO [#A] Question :QA:\n*** TODO [#A] Work\nSCHEDULED: <2026-09-16 Wed>\n") (org-mode)
   (let ((org-workflow-target-stack nil)
         (org-workflow-target-selected-date nil))
     (org-workflow-target-refresh t)
     (should (equal "Work" (org-workflow-target-entry-title (car org-workflow-target-stack))))
     (goto-char (point-min)) (search-forward "Question :QA:") (beginning-of-line)
     (org-schedule nil "2026-09-16")
     (org-workflow-target-refresh t)
     (should (equal "Work" (org-workflow-target-entry-title (car org-workflow-target-stack)))))))

(ert-deftest workflow-inbox-retains-completed-qa-and-thoughts-for-supertag ()
  (org-workflow-store-test
   (let ((org-workflow-projects-file file))
     (erase-buffer)
     (insert "* Inbox\n** DONE Answered :QA:\nCLOSED: [2026-09-15 Tue]\n** DONE Work\nCLOSED: [2026-09-15 Tue]\n*** A thought\n:PROPERTIES:\n:ID: thought\n:END:\n")
     (org-mode) (save-buffer)
     (should-not (org-workflow-inbox-archive-done "2026-09-16"))
     (should (string-match-p "Answered" (buffer-string)))
     (should (string-match-p "A thought" (buffer-string))))))

(ert-deftest workflow-daily-excludes-finished-stages-and-held-manual-targets ()
  (org-workflow-store-test
   (erase-buffer)
   (insert "* DIVE Project\n** DONE Closed stage\n*** TODO Hidden\nSCHEDULED: <2026-09-16 Wed>\n** TODO Open stage\n*** TODO Visible\nSCHEDULED: <2026-09-16 Wed>\n** HOLD Paused\n*** TODO Blocked\nSCHEDULED: <2026-09-16 Wed>\n") (org-mode)
   (org-workflow-projects-sync)
   (should (equal "Visible" (nth 5 (car (org-workflow-store-due "2026-09-16")))))
   (goto-char (point-min)) (search-forward "*** TODO Blocked") (beginning-of-line)
   (should-error (org-workflow-toggle-commitment) :type 'user-error)
   (should (equal "Visible" (nth 5 (car (org-workflow-store-due "2026-09-16")))))))

(ert-deftest workflow-sprint-real-redraw-preserves-edit-origin-row ()
  (org-workflow-store-test
   (erase-buffer)
   (insert "* DIVE Project\n** TODO Stage\n*** TODO Question :QA:\nA body\n") (org-mode)
   (let ((org-agenda-buffer-name "*wf-return-real*")
         (org-agenda-window-setup 'current-window))
     (unwind-protect
         (save-window-excursion
           (org-agenda nil "d")
           (goto-char (point-min)) (search-forward "Question") (beginning-of-line)
           (org-workflow-agenda-edit-source)
           (goto-char (point-max)) (insert "Answer\n")
           (org-workflow-agenda-edit-finish)
           (should (string-match-p "Question" (thing-at-point 'line t))))
       (when (get-buffer org-agenda-buffer-name) (kill-buffer org-agenda-buffer-name))))))

(ert-deftest workflow-daily-replacing-completed-duty-keeps-one-effective-responsibility ()
  (org-workflow-store-test
   (erase-buffer)
   (insert "* DIVE Project\n** TODO Stage\n*** TODO First\nSCHEDULED: <2026-09-16 Wed>\n*** TODO Second\nSCHEDULED: <2026-09-16 Wed>\n") (org-mode)
   (org-workflow-projects-sync)
   (let ((old (caar (org-workflow-store-due "2026-09-16"))))
     (goto-char (point-min)) (search-forward "*** TODO First") (beginning-of-line)
     (let ((org-log-done nil)) (org-todo "DONE"))
     (goto-char (point-min)) (search-forward "*** TODO Second") (beginning-of-line)
     (org-workflow-toggle-commitment)
     (should (equal "done" (nth 6 (org-workflow-store-commitment old))))
     (should (= 1 (length (org-workflow-history--responsibilities "2026-09-16")))))))

(ert-deftest workflow-qa-refinement-does-not-block-containing-task ()
  (with-temp-buffer
    (insert "* TODO Work\n** TODO Question :QA:\nSCHEDULED: <2026-09-16 Wed>\n*** TODO Investigate\n")
    (org-mode) (goto-char (point-min))
    (should (org-workflow-target--task-leaf-p))))
