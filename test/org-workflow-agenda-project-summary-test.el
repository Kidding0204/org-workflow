;;; -*- lexical-binding: t; -*-
(require 'ert)
(load "org-workflow-agenda-workbench-test" nil t)
(require 'org-workflow-agenda-projects)

(defconst workflow-summary-fixture
  "* DIVE Project [0/2]\n** DONE Small [1/1]\n*** DONE First\n** DIVE Large\n*** TODO Parent\n**** DONE Nested done\n**** TODO Nested open\n*** TODO Last\n*** TODO Question :QA:\n**** DONE QA detail\n** Plain\n** TODO Empty\n* HOLD Paused\n** Plain paused\n*** TODO Hidden task\n")

(ert-deftest workflow-summary-counts-stages-and-weighted-project-without-writes ()
  (org-workflow-workbench-test-with-files (list workflow-summary-fixture)
    (let* ((project (cadr (org-workflow-projects-collect)))
           (before (with-current-buffer (find-file-noselect (car files)) (buffer-string)))
           (progress (org-workflow-projects-progress project)))
      (should (= 2 (plist-get progress :done)))
      (should (= 4 (plist-get progress :total)))
      (should (equal '((1 1) (1 3) (0 0) (0 0))
                     (mapcar (lambda (s) (list (plist-get s :done) (plist-get s :total)))
                             (plist-get progress :stages))))
      (org-workflow-workbench-test-open)
      (should (equal before (with-current-buffer (find-file-noselect (car files)) (buffer-string)))))))

(ert-deftest workflow-summary-single-pane-order-and-minimal-rows ()
  (org-workflow-workbench-test-with-files (list workflow-summary-fixture)
    (org-workflow-workbench-test-open)
    (let (rows)
      (goto-char (point-min))
      (while (< (point) (point-max))
        (when (org-get-at-bol 'org-workflow-agenda-project-summary)
          (push (buffer-substring-no-properties (line-beginning-position) (line-end-position)) rows))
        (forward-line 1))
      (setq rows (nreverse rows))
      (should (= 7 (length rows)))
      (should (string-match-p "DIVE +Project +\\[2/4\\]" (car rows)))
      (should (string-match-p "DONE +Small +\\[1/1\\]" (cadr rows)))
      (should-not (string-match-p "0/2\\|First\\|Nested\\|Question" (mapconcat #'identity rows "\n")))
      (should (string-match-p "Plain +—" (nth 3 rows))))
    (goto-char (point-min)) (search-forward "随时")
    (let ((anytime (point)))
      (search-forward "项目\n")
      (should (> (point) anytime))
      (search-forward "今日已完成"))
    (org-workflow-agenda-set-day t)
    (should (text-property-any (point-min) (point-max) 'org-workflow-agenda-project-summary t))
    (pcase-let ((`(,left ,right) (org-workflow-workbench-test-panes)))
      (should-not (with-current-buffer left
                    (text-property-any (point-min) (point-max) 'org-workflow-agenda-project-summary t)))
      (should-not (with-current-buffer right
                    (text-property-any (point-min) (point-max) 'org-workflow-agenda-project-summary t))))))

(ert-deftest workflow-summary-modern-rendering-and-native-navigation ()
  (require 'org-modern)
  (org-workflow-workbench-test-with-files (list workflow-summary-fixture)
    (let ((org-modern-progress 12))
      (org-workflow-workbench-test-open)
      (goto-char (or (text-property-any (point-min) (point-max) 'org-workflow-agenda-project-summary t)
                     (point-min)))
      (should (org-get-at-bol 'org-workflow-agenda-project-summary))
      (let ((agenda (current-buffer)) (window (selected-window))
            (marker (copy-marker (org-get-at-bol 'org-hd-marker))))
        (should (eq (key-binding (kbd "RET")) #'org-agenda-switch-to))
        (let ((inhibit-read-only t) (org-modern-todo t)) (org-modern-agenda))
        (search-forward "DIVE")
        (should (eq 'org-modern-todo (get-text-property (- (point) 4) 'face)))
        (search-forward "[2/4]")
        (should (get-text-property (- (point) 5) 'display))
        (call-interactively (key-binding (kbd "TAB")))
        (should (eq (current-buffer) agenda))
        (should (eq (selected-window) window))
        (should (get-buffer-window (marker-buffer marker)))
        (with-current-buffer (marker-buffer marker)
          (goto-char marker) (search-forward "First")
          (should-not (org-fold-folded-p (point) 'outline)))
        (call-interactively (key-binding (kbd "RET")))
        (should (eq (current-buffer) (marker-buffer marker)))
        (should (eq (selected-window) window))
        (should (= (point) marker))))))

(ert-deftest workflow-summary-status-click-and-key-use-existing-project-api ()
  (org-workflow-workbench-test-with-files (list workflow-summary-fixture)
    (org-workflow-workbench-test-open)
    (goto-char (or (text-property-any (point-min) (point-max) 'org-workflow-agenda-project-summary t)
                   (point-min)))
    (let (changed)
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "HOLD"))
                ((symbol-function 'org-workflow-projects-set-state)
                 (lambda (marker state) (setq changed (list marker state)))))
        (call-interactively (key-binding (kbd "t")))
        (should (equal "HOLD" (cadr changed)))
        (setq changed nil)
        (let ((button (next-button (line-beginning-position))))
          (should button)
          (button-activate button))
        (should (equal "HOLD" (cadr changed)))))))

(ert-deftest workflow-summary-evil-navigation-and-state-keys ()
  (skip-unless (require 'evil nil t))
  (org-workflow-workbench-test-with-files (list workflow-summary-fixture)
    (org-workflow-workbench-test-open)
    (evil-local-mode 1) (evil-normal-state) (evil-normalize-keymaps)
    (goto-char (text-property-any (point-min) (point-max) 'org-workflow-agenda-project-summary t))
    (should (eq (key-binding (kbd "t")) #'org-workflow-agenda-project-state))
    (should (eq (key-binding (kbd "RET")) #'org-agenda-switch-to))
    (let ((agenda (current-buffer)))
      (call-interactively (key-binding (kbd "TAB")))
      (should (eq agenda (current-buffer)))
      (should (get-buffer-window (org-base-buffer (marker-buffer (org-get-at-bol 'org-hd-marker))))))))

(ert-deftest workflow-summary-long-chinese-titles-fit-with-one-progress-cookie ()
  (org-workflow-workbench-test-with-files
      (list (concat "* DIVE " (make-string 40 ?项) " [0/1]\n** DIVE Stage [0/1]\n*** TODO Task\n"))
    (org-workflow-workbench-test-open)
    (with-temp-buffer
      (let ((inhibit-read-only t))
        (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) 36)))
          (org-workflow-agenda-project-summary))
        (goto-char (text-property-any (point-min) (point-max) 'org-workflow-agenda-project-summary t))
        (should (<= (string-width (buffer-substring-no-properties (line-beginning-position) (line-end-position))) 36))
        (should (string-match-p "…" (buffer-substring-no-properties (line-beginning-position) (line-end-position))))
        (should (equal (concat (make-string 40 ?项) " [0/1]") (get-text-property (point) 'help-echo)))
        (should (= 1 (how-many "\\[0/1\\]" (line-beginning-position) (line-end-position))))))))

(ert-deftest workflow-summary-render-preserves-source-point-and-narrowing ()
  (org-workflow-workbench-test-with-files (list workflow-summary-fixture)
    (let* ((source (find-file-noselect (car files)))
           (position (with-current-buffer source (goto-char (point-min)) (search-forward "First") (point))))
      (with-current-buffer source (narrow-to-region position (point-max)))
      (with-temp-buffer (org-workflow-agenda-project-summary))
      (should (= position (with-current-buffer source (point))))
      (should (= position (with-current-buffer source (point-min)))))))

(ert-deftest workflow-summary-held-tasks-do-not-count-as-completed ()
  (org-workflow-workbench-test-with-files
      '("#+TODO: TODO DIVE | DONE HOLD\n* DIVE Project\n** DIVE Stage\n*** DONE Finished\n*** HOLD Paused\n*** TODO Open\n")
    (let ((progress (org-workflow-projects-progress (cadr (org-workflow-projects-collect)))))
      (should (= 3 (plist-get progress :total)))
      (should (= 1 (plist-get progress :done)))
      (should (= 1 (plist-get (car (plist-get progress :stages)) :done))))))

(ert-deftest workflow-summary-native-empty-cookies-are-replaced ()
  (org-workflow-workbench-test-with-files '("* DIVE Project [/]\n** Stage [%]\n*** TODO Task\n")
    (org-workflow-workbench-test-open)
    (goto-char (point-min))
    (while (< (point) (point-max))
      (when (org-get-at-bol 'org-workflow-agenda-project-summary)
        (should-not (string-match-p "\\[/\\]\\|\\[%\\]"
                                    (buffer-substring-no-properties (line-beginning-position) (line-end-position)))))
      (forward-line 1))))

(ert-deftest workflow-summary-state-change-retains-row-when-earlier-tasks-disappear ()
  (org-workflow-workbench-test-with-files
      '("* DIVE Project\n** DIVE Stage\n*** TODO Task\nSCHEDULED: <2026-08-17 Mon>\n* HOLD Other\n** DIVE Other stage\n")
    (org-workflow-workbench-test-open)
    (goto-char (text-property-any (point-min) (point-max) 'org-workflow-agenda-project-summary t))
    (org-workflow-agenda-project-state nil "HOLD")
    (should (equal "Project" (plist-get (org-get-at-bol 'workflow-project) :title)))
    (should (equal "HOLD" (org-get-at-bol 'todo-state)))))
