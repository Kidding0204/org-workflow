   (insert "* DONE Empty project\nCLOSED: [2026-09-16 Wed] SCHEDULED: <2026-09-16 Wed>\n* DIVE Another\n** DONE Empty stage\nCLOSED: [2026-09-16 Wed] SCHEDULED: <2026-09-16 Wed>\n")
   (should-not (org-workflow-agenda--with-completed nil "2026-09-16" nil))))

(ert-deftest workflow-integrated-project-layout-and-modern-keywords ()
  (workflow-integrated-fixture
   (goto-char (point-min)) (search-forward "* TODO Algebra") (beginning-of-line)
   (insert "** DIVE Second stage\n*** TODO Hidden task\n")
   (let ((items (org-workflow-projects-collect)))
     (with-temp-buffer
       (cl-letf (((symbol-function 'org-workflow-projects-collect) (lambda () items))
                 ((symbol-function 'org-workflow-agenda-target-date) (lambda () "2026-09-16")))
         (org-workflow-agenda-projects nil))
       (should (string-match-p "TODO Tokens" (buffer-string)))
       (should (string-match-p "DIVE Second stage" (buffer-string)))
       (dolist (hidden '("Hidden task" "Matrices" "Product" "Review" "Again"))
         (should-not (string-match-p hidden (buffer-string))))
       (should-not (string-match-p "连续" (buffer-string)))
       (should-not (string-match-p "\n\n +TODO Algebra" (buffer-string)))
       (goto-char (point-min)) (search-forward "DIVE Compiler")
       (should (eq (get-text-property (1- (point)) 'face) 'org-workflow-agenda-project-title))
       (beginning-of-line)
       (should (get-text-property (point) 'org-todo-regexp))
       (require 'org-modern)
       (let ((org-modern-todo t) (org-modern-todo-faces nil)) (org-modern-agenda))
       (goto-char (point-min)) (search-forward "DIVE Compiler")
       (should (eq (get-text-property (- (point) (length "DIVE Compiler")) 'face) 'org-modern-todo))))))

(ert-deftest workflow-integrated-habit-only-period-is-not-empty ()
  (dolist (placement '(early late))
    (with-temp-buffer
      (cl-letf (((symbol-function 'org-workflow-target--ordered-entries) (lambda (&rest _) nil))
                ((symbol-function 'org-workflow-agenda--with-completed) (lambda (&rest _) nil))
                ((symbol-function 'org-workflow-evening--insert-habits)
                 (lambda (_ letter position)
                   (when (and (= letter ?C) (eq position placement)) (insert "    Habit\n")))))
        (org-workflow-agenda-task-stack nil '(habit)))
      (goto-char (point-min)) (search-forward "晚上")
      (should (search-forward "Habit" nil t))
      (should-not (search-forward "暂无安排" nil t))
      (should (= 2 (how-many "暂无安排" (point-min) (point-max)))))))

(ert-deftest workflow-integrated-project-cookie-rendering ()
  (require 'org-modern)
  (with-temp-buffer
    (insert "    TODO Project [2/4] [50%]\n")
    (let ((org-modern-progress 12))
      (org-workflow-agenda-projects--cookies (point-min) (point-max)))
    (goto-char (point-min))
    (while (search-forward "[" nil t)
      (should (get-text-property (1- (point)) 'display))
      (should (eq (get-text-property (1- (point)) 'face) 'org-modern-label)))))

(ert-deftest workflow-integrated-compact-section-order ()
  (let ((org-workflow-agenda--pane-role 'combined) calls)
    (cl-letf (((symbol-function 'org-workflow-agenda--setting) (lambda (_) nil))
              ((symbol-function 'org-workflow-evening--habit-rows) (lambda (_) nil))
              ((symbol-function 'org-workflow-agenda-deadline-goals) (lambda (_) nil))
              ((symbol-function 'org-workflow-agenda-task-stack) (lambda (&rest _) (push 'schedule calls)))
              ((symbol-function 'org-workflow-agenda-inbox) (lambda (&rest _) (push 'inbox calls)))
              ((symbol-function 'org-workflow-agenda-projects) (lambda (_) (push 'projects calls))))
      (org-workflow-agenda-workbench-view nil))
    (should (equal (nreverse calls) '(schedule inbox projects)))))
