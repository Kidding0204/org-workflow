;;; org-workflow-agenda-habit-render-test.el --- Per-render habit reads -*- lexical-binding: t; -*-
(require 'ert)
(require 'org-workflow-evening)
(load "org-workflow-agenda-workbench-test" nil t)

(defconst workflow-habit-render-test-source
  "#+filetags: :project:\n#+TODO: TODO DIVE | DONE HOLD\n* DIVE Stage\n** TODO Morning habit\nSCHEDULED: <2026-08-17 Mon .+1d>\n:PROPERTIES:\n:STYLE: habit\n:WORKFLOW_HABIT_POSITION: morning-early\n:END:\n** TODO Free habit\nSCHEDULED: <2026-08-17 Mon .+1d>\n:PROPERTIES:\n:STYLE: habit\n:END:\n")

(ert-deftest workflow-habit-render-reads-once-and-skips-tomorrow ()
  (dolist (source (list workflow-habit-render-test-source "* Fixture\n** DIVE Stage\n*** TODO Task\n"))
    (let ((map-habits (symbol-function 'org-workflow-habits--map)) (scans 0))
      (org-workflow-workbench-test-with-files (list source)
        (let ((org-workflow-habit-file (car files)))
          (cl-letf (((symbol-function 'org-workflow-habits--map)
                     (lambda (function) (cl-incf scans) (funcall map-habits function))))
            (set-buffer (org-workflow-workbench-test-open))
            (should (= 1 scans))
            (when (equal source workflow-habit-render-test-source)
              (dolist (title '("Morning habit" "Free habit"))
                (should (= 1 (how-many (regexp-quote title) (point-min) (point-max))))))
            (org-workflow-agenda-set-day t)
            (should (= 1 scans))
            (should-not (member "Morning habit" (org-workflow-workbench-test-titles)))
            (org-workflow-agenda-set-day nil)
            (should (= 2 scans))))))))

(ert-deftest workflow-habit-render-rereads-unsaved-repeat-and-title-edits ()
  (let ((map-habits (symbol-function 'org-workflow-habits--map)))
    (org-workflow-workbench-test-with-files (list workflow-habit-render-test-source)
      (let ((org-workflow-habit-file (car files)))
        (cl-letf (((symbol-function 'org-workflow-habits--map) map-habits)
                  ((symbol-function 'org-current-time)
                   (lambda (&rest _) (encode-time 0 0 20 17 8 2026)))
                  ((symbol-function 'org-today)
                   (lambda () (time-to-days (encode-time 0 0 20 17 8 2026)))))
          (set-buffer (org-workflow-workbench-test-open))
          (goto-char (point-min)) (search-forward "Free habit")
          (let ((marker (copy-marker (org-get-at-bol 'org-hd-marker))))
            (org-agenda-todo 'done)
            (org-workflow-agenda--refresh-native-edit)
            (should-not (member "Free habit" (org-workflow-workbench-test-titles)))
            (org-with-point-at marker
              (should (equal "TODO" (org-get-todo-state)))
              (should (equal "2026-08-18" (org-workflow-target--timestamp-date
                                           (org-entry-get nil "SCHEDULED")))))
            (set-marker marker nil))
          (with-current-buffer (find-file-noselect (car files))
            (goto-char (point-min)) (search-forward "Morning habit")
            (replace-match "Edited morning habit" t t)
            (should (buffer-modified-p)))
          (org-agenda-redo)
          (let ((titles (org-workflow-workbench-test-titles)))
            (should (member "Edited morning habit" titles))
            (should-not (member "Morning habit" titles))))))))
