;;; org-workflow-projects-test.el --- Project learning contracts -*- lexical-binding: t; -*-
(require 'ert)
(load "org-workflow-store-test" nil t)
(require 'org-workflow-projects nil t)
(require 'org-workflow-project-view nil t)

(defmacro workflow-project-fixture (&rest body)
  `(org-workflow-store-test
    (erase-buffer)
    (insert "#+filetags: :project:\n* DIVE Compiler\n:PROPERTIES:\n:ID: compiler\n:END:\n** DIVE Lexing\n*** TODO Tokens\n*** TODO Parser\n* TODO Algebra\n:PROPERTIES:\n:ID: algebra\n:END:\n** TODO Basics\n*** TODO Matrices\n* HOLD Old\n:PROPERTIES:\n:ID: old\n:END:\n** TODO Review\n*** TODO Old step\n")
    (org-mode)
    (let ((org-workflow-projects--syncing nil)
          (org-workflow-projects--batch nil))
      (cl-letf (((symbol-function 'org-workflow-store--now)
                 (lambda () (concat (org-workflow-target--today-string) "T12:00:00+08:00"))))
        ,@body))))

(defun workflow-project-at (title)
  (goto-char (point-min))
  (re-search-forward (concat "^\\*+ .*" (regexp-quote title) "$"))
  (beginning-of-line)
  (point-marker))

(ert-deftest workflow-project-discovery-is-read-only-and-structural ()
  (workflow-project-fixture
   (let ((before (buffer-string)) (position (point)))
     (let* ((rows (org-workflow-projects-collect))
            (project (seq-find (lambda (x) (equal (plist-get x :id) "compiler")) rows)))
       (should (= 4 (length rows)))
       (should (equal (plist-get (car rows) :id) (plist-get project :goal-id)))
       (should (equal "Tokens" (plist-get (plist-get project :next) :title)))
       (should (equal "Lexing" (plist-get project :phase))))
     (should (equal before (buffer-string)))
     (should (= position (point))))))

(ert-deftest workflow-project-daily-freezes-and-rolls-without-debt ()
  (workflow-project-fixture
   (org-workflow-projects-sync)
   (org-workflow-projects-sync)
   (should (= 1 (length (org-workflow-store-due "2026-09-16"))))
   (let ((yesterday (caar (org-workflow-store-due "2026-09-16"))))
     (cl-letf (((symbol-function 'org-workflow-target--today-string) (lambda () "2026-09-17")))
       (org-workflow-projects-sync)
       (should (= 1 (length (org-workflow-history--responsibilities "2026-09-17"))))
       (workflow-project-at "Tokens")
       (org-todo "DONE")
       (org-workflow-projects-sync)
       (should (= 1 (length (org-workflow-store-due "2026-09-17"))))
       (should (equal "pending" (org-workflow-history--row-state
                                 (org-workflow-store-commitment yesterday) "2026-09-16")))
       (should (= 1 (plist-get (org-workflow-history-progress "2026-09-17") :minimumSatisfied)))))))

(ert-deftest workflow-project-goal-pause-resume-honors-provenance ()
  (workflow-project-fixture
   (org-workflow-projects-sync)
   (let ((id (caar (org-workflow-store-due "2026-09-16")) ))
     (org-workflow-projects-goal-state (copy-marker (point-min)) t)
     (should-not (org-workflow-history--responsibilities "2026-09-16"))
     (should (equal "withdrawn" (nth 6 (org-workflow-store-commitment id))))
     (org-workflow-projects-goal-state (copy-marker (point-min)) nil)
     (should (= 1 (length (org-workflow-store-due "2026-09-16"))))
     (should (equal "pending" (nth 6 (org-workflow-store-commitment id))))
     (workflow-project-at "Algebra") (should (equal "TODO" (org-get-todo-state)))
     (workflow-project-at "Old") (should (equal "HOLD" (org-get-todo-state)))
     (org-workflow-projects-goal-state (copy-marker (point-min)) t)
     (org-workflow-projects-set-state (workflow-project-at "Compiler") "TODO")
     (org-workflow-projects-goal-state (copy-marker (point-min)) nil)
     (workflow-project-at "Compiler") (should (equal "TODO" (org-get-todo-state))))))

(ert-deftest workflow-project-start-date-stays-on-project ()
  (workflow-project-fixture
   (org-workflow-projects-set-start (workflow-project-at "Algebra") "2026-09-17")
   (workflow-project-at "Algebra")
   (should (org-entry-get nil "SCHEDULED"))
   (workflow-project-at "Matrices") (should-not (org-entry-get nil "SCHEDULED"))
   (cl-letf (((symbol-function 'org-workflow-target--today-string) (lambda () "2026-09-17")))
     (org-workflow-projects-sync)
     (workflow-project-at "Algebra") (should (equal "DIVE" (org-get-todo-state)))
     (workflow-project-at "Matrices") (should (org-entry-get nil "WORKFLOW_COMMITMENT_ID"))))
)
(ert-deftest workflow-project-completed-pause-does-not-create-another-promise ()
  (workflow-project-fixture
   (org-workflow-projects-sync)
   (workflow-project-at "Tokens") (org-todo "DONE")
   (org-workflow-projects-set-state (workflow-project-at "Compiler") "HOLD")
   (should (= 1 (plist-get (org-workflow-history-progress "2026-09-16") :minimumSatisfied)))
   (org-workflow-projects-set-state (workflow-project-at "Compiler") "DIVE")
   (should (= 1 (length (org-workflow-store-due "2026-09-16"))))))

(ert-deftest workflow-project-view-is-read-only-and-shows-planning ()
  (workflow-project-fixture
   (let ((before (buffer-string)))
     (unwind-protect
         (with-current-buffer (get-buffer-create "*Workflow Projects*")
           (org-workflow-project-view-mode)
           (org-workflow-project-view-refresh)
           (should buffer-read-only)
           (should (string-match-p "Compiler" (buffer-string)))
           (should (string-match-p "Tokens" (buffer-string)))
           (should-not (string-match-p "◇\\|↳" (buffer-string))))
       (when (get-buffer "*Workflow Projects*") (kill-buffer "*Workflow Projects*")))
     (should (equal before (buffer-string))))))

(ert-deftest workflow-project-floor-is-global-and-completion-only ()
  (workflow-project-fixture
   (org-workflow-store-set-meta "completion-floor-since" "2026-09-16")
   (org-workflow-store-set-meta "daily-minutes:2026-09-16" "60")
   (org-workflow-store-set-meta "attempt-progress-since" "2026-09-01")
   (org-workflow-projects-sync)
   (workflow-project-at "Tokens")
   (org-end-of-meta-data t)
   (insert "CLOCK: [2026-09-16 Wed 09:00]--[2026-09-16 Wed 09:20] =>  0:20\n")
   (let ((progress (org-workflow-history-progress "2026-09-16")))
     (should (= 0 (plist-get progress :minimumSatisfied)))
     (should (eq :false (plist-get progress :dailyFloorComplete))))
   (workflow-project-at "Matrices")
   (org-end-of-meta-data t)
   (insert "CLOCK: [2026-09-16 Wed 10:00]--[2026-09-16 Wed 10:40] =>  0:40\n")
   (let ((progress (org-workflow-history-progress "2026-09-16")))
     (should (eq :false (plist-get progress :commitmentComplete)))
     (should (eq t (plist-get progress :dailyFloorComplete)))
     (should (equal "investment" (plist-get progress :dailyFloorBasis)))
     (should (= 60 (plist-get progress :focusTotalMinutes))))
   (org-workflow-projects-goal-state (copy-marker (point-min)) t)
   (should (eq t (plist-get (org-workflow-history-progress "2026-09-16") :dailyFloorComplete)))
   (should (= 0 (plist-get (org-workflow-history-progress "2026-09-16") :minimumTotal)))))

