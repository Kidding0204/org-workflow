;;; org-workflow-agenda-agenda-create-test.el --- Sprint direct creation -*- lexical-binding: t; -*-
(require 'ert)
(require 'evil)
(require 'org-workflow-agenda)
(require 'org-workflow-weekly)
(require 'org-workflow-evening)

(ert-deftest note-gtd-sprint-creates-task-from-empty-period ()
  (let* ((directory (make-temp-file "sprint-create-" t))
         (file (expand-file-name "2026-09-21.org" directory))
         (org-workflow-projects-file file)
         (org-agenda-files (list file))
         (org-agenda-buffer-name "*Sprint create test*")
         (org-workflow-agenda-columns-enabled nil))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "#+filetags: :area:\n* Inbox\n:PROPERTIES:\n:JOURNAL_INBOX: 2026-09-21\n:END:\n"))
          (cl-letf (((symbol-function 'org-workflow-target--today-string)
                     (lambda () "2026-09-23"))
                    ((symbol-function 'read-string)
                     (lambda (&rest _) "新增练习")))
            (org-agenda nil "d")
            (with-current-buffer org-agenda-buffer-name
              (goto-char (point-min))
              (search-forward "上午")
              (beginning-of-line)
              (should (equal '(task "2026-09-23" 65)
                             (get-text-property (point) 'org-workflow-agenda-create-context)))
              (org-workflow-agenda-create-at-point)
              (should (search-forward "新增练习" nil t))
              (should (org-get-at-bol 'org-hd-marker)))
            (with-temp-buffer
              (insert-file-contents file)
              (should (string-match-p "\\*\\* TODO \\[#[A]\\] 新增练习" (buffer-string)))
              (should (string-match-p "SCHEDULED: <2026-09-23" (buffer-string))))))
      (when-let* ((buffer (get-buffer org-agenda-buffer-name))) (kill-buffer buffer))
      (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest note-gtd-week-agenda-rotates-only-past-journals ()
  (let* ((directory (make-temp-file "week-rotate-" t))
         (vulpea-default-notes-directory directory)
         (current (org-workflow-week-file "2026-09-23"))
         (old (org-workflow-week-file "2026-09-16"))
         (future (org-workflow-week-file "2026-09-30"))
         (other (expand-file-name "project.org" directory))
         (org-agenda-files (list old future other)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory current) t)
          (dolist (file (list old future current))
            (with-temp-file file (insert "#+filetags: :journal-week:\n* 收集箱\n")))
          (with-temp-file other (insert "#+filetags: :project:\n"))
          (cl-letf (((symbol-function 'org-workflow-target--today-string)
                     (lambda () "2026-09-23"))
                    ((symbol-function 'org-store-new-agenda-file-list)
                     (lambda (files) (setq org-agenda-files files)))
                    ((symbol-function 'org-install-agenda-files-menu) #'ignore))
            (org-workflow-week-ensure)
            (should (member current (mapcar #'expand-file-name org-agenda-files)))
            (should (member future (mapcar #'expand-file-name org-agenda-files)))
            (should (member other (mapcar #'expand-file-name org-agenda-files)))
            (should-not (member old (mapcar #'expand-file-name org-agenda-files)))
            (with-current-buffer (find-file-noselect current)
              (should (member "area" org-file-tags)))))
      (dolist (file (list current old future other))
        (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer)))
      (delete-directory directory t))))

(ert-deftest note-gtd-sprint-creates-habit-from-habit-section ()
  (let* ((directory (make-temp-file "sprint-habit-" t))
         (org-workflow-habit-file (expand-file-name "habits.org" directory))
         (org-agenda-files nil)
         (org-agenda-buffer-name "*Sprint habit create test*")
         (org-workflow-agenda-columns-enabled nil))
    (unwind-protect
        (cl-letf (((symbol-function 'org-workflow-target--today-string)
                   (lambda () "2026-09-23"))
                  ((symbol-function 'read-string)
                   (lambda (&rest _) "每日复习")))
          (with-temp-file org-workflow-habit-file
            (insert "#+TODO: TODO | DONE\n* TODO Existing habit\nSCHEDULED: <2026-09-23 Wed .+1d>\n:PROPERTIES:\n:STYLE: habit\n:END:\n"))
          (org-agenda nil "d")
          (with-current-buffer org-agenda-buffer-name
            (goto-char (point-min))
            (search-forward "习惯")
            (should (eq 'org-workflow-agenda-meta (get-text-property (1- (point)) 'face)))
            (should (get-text-property (1- (point)) 'org-agenda-structural-header))
            (beginning-of-line)
            (should (eq 'habit (get-text-property (point) 'org-workflow-agenda-create-context)))
            (org-workflow-agenda-create-at-point))
          (with-temp-buffer
            (insert-file-contents org-workflow-habit-file)
            (should (string-match-p "\\* TODO 每日复习" (buffer-string)))
            (should (string-match-p ":STYLE: habit" (buffer-string)))))
      (when-let* ((buffer (get-buffer org-agenda-buffer-name))) (kill-buffer buffer))
      (when-let* ((buffer (get-file-buffer org-workflow-habit-file))) (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest note-gtd-sprint-creates-task-in-future-period ()
  (let* ((directory (make-temp-file "sprint-future-create-" t))
         (file (expand-file-name "2026-09-21.org" directory))
         (org-workflow-projects-file file)
         (org-agenda-files (list file))
         (org-agenda-buffer-name "*Sprint future create test*")
         (org-workflow-agenda-columns-enabled nil))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "#+filetags: :area:\n* Inbox\n** TODO [#B] Existing\nSCHEDULED: <2026-09-24 Thu>\n"))
          (cl-letf (((symbol-function 'org-workflow-target--today-string)
                     (lambda () "2026-09-23"))
                    ((symbol-function 'read-string)
                     (lambda (&rest _) "未来任务")))
            (org-agenda nil "d")
            (with-current-buffer org-agenda-buffer-name
              (org-workflow-agenda-set-day t)
              (goto-char (point-min))
              (search-forward "Existing")
              (beginning-of-line)
              (should (equal '(task "2026-09-24" 66)
                             (get-text-property (point) 'org-workflow-agenda-create-context)))
              (org-workflow-agenda-create-at-point)
              (should (search-forward "未来任务" nil t)))
            (with-temp-buffer
              (insert-file-contents file)
              (should (string-match-p "\\*\\* TODO \\[#[B]\\] 未来任务" (buffer-string)))
              (should (string-match-p "SCHEDULED: <2026-09-24" (buffer-string))))))
      (when-let* ((buffer (get-buffer org-agenda-buffer-name))) (kill-buffer buffer))
      (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer))
      (delete-directory directory t))))

(unless (fboundp 'org-workflow-store-test)
  (load (expand-file-name "org-workflow-store-test.el"
                          (file-name-directory load-file-name)) nil t))

(ert-deftest workflow-sprint-create-tomorrow-records-commitment ()
  (org-workflow-store-test
   (let ((org-workflow-projects-file file))
     (org-workflow-agenda-create-task "Tomorrow" "2026-09-17" ?B)
     (goto-char (point-min)) (search-forward "Tomorrow") (beginning-of-line)
     (let ((id (org-entry-get nil "WORKFLOW_COMMITMENT_ID")))
       (should id)
       (should (equal "2026-09-17" (nth 3 (org-workflow-store-commitment id))))
       (should (= ?B (nth 3 (org-heading-components)))))
     (org-workflow-agenda-create-task "Today" "2026-09-16" ?A)
     (goto-char (point-min)) (search-forward "Today") (beginning-of-line)
     (should-not (org-entry-get nil "WORKFLOW_COMMITMENT_ID"))
     (should (= 1 (length (org-workflow-store-due "2026-09-17")))))))

(ert-deftest workflow-sprint-create-failure-restores-inbox-and-facts ()
  (org-workflow-store-test
   (let ((org-workflow-projects-file file)
         (before (buffer-string))
         (create (symbol-function 'org-workflow-store-create)))
     (cl-letf (((symbol-function 'org-workflow-store-create)
                (lambda (&rest args)
                  (apply create args)
                  (error "Injected creation failure"))))
       (should-error (org-workflow-agenda-create-task "Tomorrow" "2026-09-17" ?B)))
     (should (equal before (buffer-string)))
     (should-not (org-workflow-store-due "2026-09-17"))
     (should (equal before (with-temp-buffer
                            (insert-file-contents file) (buffer-string)))))))

(ert-deftest workflow-sprint-create-new-file-commit-failure-restores-buffer ()
  (org-workflow-store-test
   (let* ((new-file (expand-file-name "new.org" directory))
          (org-workflow-projects-file new-file)
          (org-agenda-files (list new-file))
          (execute (symbol-function 'sqlite-execute)))
     (unwind-protect
         (progn
           (cl-letf (((symbol-function 'sqlite-execute)
                      (lambda (db sql &rest args)
                        (if (string-prefix-p "UPDATE operations SET state='applied'" sql)
                            (error "Injected post-edit database failure")
                          (apply execute db sql args)))))
             (should-error (org-workflow-agenda-create-task "New task" "2026-09-17" ?B)))
           (should-not (file-exists-p new-file))
           (with-current-buffer (get-file-buffer new-file)
             (should (equal "" (buffer-string))))
           (should-not (org-workflow-store-due "2026-09-17")))
       (when-let* ((buffer (get-file-buffer new-file)))
         (with-current-buffer buffer (set-buffer-modified-p nil))
         (kill-buffer buffer))))))

(ert-deftest workflow-sprint-create-postcommit-failure-keeps-source-and-facts ()
  (dolist (function '(org-workflow-store-checkpoint org-workflow-target-refresh))
    (org-workflow-store-test
     (let ((org-workflow-projects-file file))
       (cl-letf (((symbol-function function)
                  (lambda (&rest _)
                    (unless org-workflow-store--in-operation
                      (error "Injected post-commit failure")))))
         (should-error (org-workflow-agenda-create-task "Tomorrow" "2026-09-17" ?B)))
       (should (string-match-p "Tomorrow" (buffer-string)))
       (goto-char (point-min)) (search-forward "Tomorrow") (beginning-of-line)
       (should (equal "Tomorrow"
                      (nth 5 (org-workflow-store-commitment
                              (org-entry-get nil "WORKFLOW_COMMITMENT_ID")))))
       (should (= 1 (length (org-workflow-store-due "2026-09-17"))))))))
