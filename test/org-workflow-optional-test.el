;;; org-workflow-optional-test.el --- All-day choices -*- lexical-binding: t; -*-
(require 'org-workflow-agenda)
(load "org-workflow-sources-test" nil t)

(ert-deftest workflow-anytime-shows-four-project-steps-and-completes-without-focus ()
  (workflow-source-test
   (let ((org-agenda-files (list org-workflow-projects-file))
         (org-agenda-buffer-name "*Optional test*")
         (org-agenda-window-setup 'current-window)
         (org-workflow-agenda-columns-enabled nil)
         (org-workflow-executing-marker nil))
     (with-temp-file org-workflow-projects-file
       ;; Project roots and their stages are structural; executable steps start at level three.
       (insert "#+TODO: TODO DIVE | DONE HOLD\n* Inbox\n** TODO Collected task\n:PROPERTIES:\n:CAPTURED_ON: 2026-10-10\n:END:\n** DONE Completed capture\n* 习惯\n** TODO Free reading\nSCHEDULED: <2026-10-10 Sat .+1d>\n:PROPERTIES:\n:STYLE: habit\n:ID: free-reading\n:WORKFLOW_HABIT_WEEK_TARGET: 1\n:END:\n** TODO Timed habit\nSCHEDULED: <2026-10-10 Sat .+1d>\n:PROPERTIES:\n:STYLE: habit\n:ID: timed-habit\n:WORKFLOW_HABIT_POSITION: morning-early\n:END:\n* DIVE First project\n** DIVE First stage\n*** TODO First one\n*** TODO First two\n*** TODO First three\n*** TODO First four\n*** TODO First five\n*** TODO Scheduled\nSCHEDULED: <2026-10-10 Sat>\n* DIVE Second project\n** DIVE Second stage\n*** TODO Second one\n*** TODO Second two\n*** TODO Second three\n* TODO Backlog\n** TODO Inactive stage\n*** TODO Inactive leaf\n"))
     (unwind-protect
         (save-window-excursion
           (cl-letf (((symbol-function 'org-workflow-target--today-string) (lambda () "2026-10-10"))
                     ((symbol-function 'org-workflow-collection-inbox--review-files)
                      (lambda () (list org-workflow-projects-file)))
                     ((symbol-function 'current-time) (lambda () (encode-time 0 0 12 10 10 2026)))
                     ((symbol-function 'org-workflow-clock--start)
                      (lambda (&rest _) (ert-fail "Optional completion started focus"))))
             (org-agenda nil "d")
             (let* ((text (buffer-string))
                    (optional-start (or (string-match "\n随时\n" text)
                                        (ert-fail "Anytime section is missing")))
                    (optional-end (string-match "今日已完成" text optional-start))
                    (optional (substring text optional-start optional-end)))
               (should (< (string-match "Free reading" optional)
                          (string-match "Collected task" optional)))
               (dolist (title '("First one" "First two" "First three" "First four"
                                "Second one" "Second two" "Second three"))
                 (should (string-match-p title optional)))
               (dolist (title '("First five" "Inactive leaf" "Completed capture" "Scheduled" "Timed habit"))
                 (should-not (string-match-p title optional)))
               (should (< (string-match "First one" optional) (string-match "First four" optional)))
               (should (< (string-match "First four" optional) (string-match "Second one" optional)))
               (should (= 1 (how-many "Free reading" (point-min) (point-max)))))
             (goto-char (point-min)) (search-forward "Collected task")
             (let ((marker (copy-marker (org-get-at-bol 'org-hd-marker))))
               (should (marker-buffer marker))
               (org-agenda-todo 'done)
               (should (equal "DONE" (org-with-point-at marker (org-get-todo-state))))
               ;; Native TODO updates its row; a redraw rebuilds the completed review.
               (org-agenda-redo)
               (goto-char (point-min))
               (search-forward "今日已完成")
               (search-forward "Collected task")
               (should (equal marker (org-get-at-bol 'org-hd-marker))))
             (should-not org-workflow-executing-marker)
             (should-not (org-clocking-p))))
       (when-let* ((buffer (get-buffer org-agenda-buffer-name))) (kill-buffer buffer))))))
