#!/usr/bin/env bash
set -euo pipefail

action=${1:-}
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
emacs_client="$script_dir/emacs-systemd-client"

case "$action" in
    select|start|toggle|step|prerequisite|defer|defer-group|complete|rest|cancel|record-last-pomodoro|visit|agenda|week|history)
        ;;
    *)
        printf 'Unknown Org Workflow action: %s\n' "$action" >&2
        exit 64
        ;;
esac

case "$action" in
    select)
        exec "$emacs_client" --no-wait --create-frame \
            --frame-parameters='((name . "workflow-select") (minibuffer . only) (width . 100) (height . 18) (menu-bar-lines . 0) (tool-bar-lines . 0))' \
            --eval '(org-workflow-select-in-new-frame)'
        ;;
    visit|step|prerequisite|agenda|week|history)
        "$emacs_client" --no-wait --reuse-frame
        exec "$emacs_client" --eval \
            "(org-workflow-dispatch-in-frame (quote $action))"
        ;;
    *)
        exec "$emacs_client" --eval \
            "(org-workflow-dispatch (quote $action))"
        ;;
esac
