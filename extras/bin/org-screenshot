#!/usr/bin/python3
"""Write a portal screenshot (or clipboard PNG) to an exclusive destination."""
import argparse
import os
import shutil
import subprocess
import sys
import uuid


def screenshot():
    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    token = "org_capture_" + uuid.uuid4().hex
    path = "/org/freedesktop/portal/desktop/request/" + bus.get_unique_name()[1:].replace(".", "_") + "/" + token
    loop = GLib.MainLoop()
    result = {}

    def response(_bus, _sender, _path, _interface, _signal, parameters):
        code, values = parameters.unpack()
        result.update(code=code, uri=values.get("uri"))
        loop.quit()

    subscription = bus.signal_subscribe(
        "org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request",
        "Response", path, None, Gio.DBusSignalFlags.NONE, response)
    handle = None

    def timeout():
        result["code"] = 2
        loop.quit()
        return False

    timer = GLib.timeout_add_seconds(300, timeout)
    try:
        reply = bus.call_sync(
            "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
            "org.freedesktop.portal.Screenshot", "Screenshot",
            GLib.Variant("(sa{sv})", ("", {
                "handle_token": GLib.Variant("s", token),
                "interactive": GLib.Variant("b", True)})),
            GLib.VariantType.new("(o)"), Gio.DBusCallFlags.NONE, 30000, None)
        handle = reply.unpack()[0]
        if handle != path:
            raise RuntimeError("Screenshot portal returned an unexpected request handle")
        loop.run()
        if result.get("code") == 1:
            raise InterruptedError("截图已取消")
        if result.get("code") != 0 or not result.get("uri"):
            raise RuntimeError("截图失败或等待超时")
        source = Gio.File.new_for_uri(result["uri"]).get_path()
        if not source:
            raise RuntimeError("截图服务未返回本地图片")
        return source
    finally:
        bus.signal_unsubscribe(subscription)
        if result.get("code") != 2:
            GLib.source_remove(timer)
        if handle and result.get("code") != 0:
            try:
                bus.call_sync("org.freedesktop.portal.Desktop", handle,
                              "org.freedesktop.portal.Request", "Close", None,
                              None, Gio.DBusCallFlags.NONE, 1000, None)
            except GLib.Error:
                pass


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--clipboard", action="store_true")
    parser.add_argument("destination")
    args = parser.parse_args()
    created = False
    try:
        source = None if args.clipboard else screenshot()
        with open(args.destination, "xb") as output:
            created = True
            if args.clipboard:
                subprocess.run(["wl-paste", "--no-newline", "--type", "image/png"],
                               stdout=output, check=True, timeout=15)
            else:
                with open(source, "rb") as image:
                    shutil.copyfileobj(image, output)
        with open(args.destination, "rb") as image:
            if image.read(8) != b"\x89PNG\r\n\x1a\n":
                raise RuntimeError("未取得 PNG 图片；请先截图再收集")
    except Exception as error:
        if created:
            os.unlink(args.destination)
        print(str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
